<UserControl x:Class="Produktionsplanung.App.Views.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="218" Height="58">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="11" Background="#F4F8FC" VerticalAlignment="Center">
            <Image Source="{StaticResource SolutionCompaktIcon}"
                   Width="34" Height="34" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   SnapsToDevicePixels="True" />
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Solution" FontSize="18" FontWeight="SemiBold" Foreground="#102A43" />
                <TextBlock Text="Compakt" FontSize="18" FontWeight="SemiBold" Foreground="#2563EB" />
            </StackPanel>
            <TextBlock Text="Production &amp; Workforce" FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" Margin="1,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
