<UserControl x:Class="Produktionsplanung.App.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource PageHeaderSpacing}">
            <TextBlock Text="Schichten" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Schichtzeiten und Pausen zentral verwalten."
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Grid>
                <DataGrid x:Name="ShiftsGrid"
                          ItemsSource="{Binding Shifts}"
                          SelectedItem="{Binding SelectedShift}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat={}{0:hh\\:mm}}" Width="90" />
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndTime, StringFormat={}{0:hh\\:mm}}" Width="90" />
                        <DataGridTextColumn Header="Pause (Min.)" Binding="{Binding BreakMinutes}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Style="{StaticResource EmptyStateStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource EmptyStateStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=ShiftsGrid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Noch keine Schichten vorhanden."
                                   Style="{StaticResource CardTitleTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Lege rechts eine Schicht an, um sie hier anzuzeigen."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,4,0,0"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                <StackPanel>
                    <TextBlock Text="Schicht bearbeiten"
                               Style="{StaticResource DialogTitleTextStyle}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Name" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Startzeit (HH:mm)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Endzeit (HH:mm)" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="Pause in Minuten" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding BreakMinutes}" Margin="0,0,0,16" />

                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Neu"
                                Command="{Binding NewShiftCommand}"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="Speichern"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                        <Button Content="In Papierkorb"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerActionButtonStyle}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>