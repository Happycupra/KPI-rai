# Copy to .env.central (never commit the real file) and start with:
# docker compose --env-file .env.central -f docker-compose.central.yml up -d --build

POSTGRES_PASSWORD=CHANGE-TO-A-LONG-RANDOM-PASSWORD
SOLUTIONCOMPAKT_JWT_KEY=CHANGE-TO-A-RANDOM-SECRET-WITH-AT-LEAST-32-BYTES

# Safe single-PC default. For a second PC on the same trusted LAN/VPN,
# bind PostgreSQL to the server LAN IP or 0.0.0.0 and restrict port 5432 in the firewall.
POSTGRES_BIND_IP=127.0.0.1
SERVER_BIND_IP=0.0.0.0
