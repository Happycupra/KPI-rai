<UserControl x:Class="Produktionsplanung.App.Views.WorkTimeCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource PageHeaderSpacing}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Arbeitszeit &amp; Betriebskalender" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="{Binding MonthText}" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,3,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Content="‹" Width="38" Height="38" Command="{Binding PreviousMonthCommand}" Margin="0,0,6,0" Style="{StaticResource CompactButtonStyle}"/>
                <Button Content="Aktueller Monat" Command="{Binding CurrentMonthCommand}" Margin="0,0,6,0" Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="›" Width="38" Height="38" Command="{Binding NextMonthCommand}" Margin="0,0,12,0" Style="{StaticResource CompactButtonStyle}"/>
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}"/>
            </WrapPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Arbeitszeitkonto">
                <Grid Margin="14,16,14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="0.9*"/><RowDefinition Height="14"/><RowDefinition Height="1.1*"/></Grid.RowDefinitions>

                    <Border Style="{StaticResource SectionCardStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Soll / Plan / Ist je Mitarbeiter" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Balances}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="2*"/>
                                    <DataGridTextColumn Header="Soll h" Binding="{Binding TargetHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Plan h" Binding="{Binding PlannedHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Ist h" Binding="{Binding ActualHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Saldo h" Binding="{Binding BalanceHours, StringFormat=+0.0;-0.0;0.0}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Erfasste Arbeitszeiten" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8"/>
                            <DataGrid x:Name="WorkTimeEntriesGrid" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="WorkTimeRow_PreviewMouseRightButtonDown"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                    <MenuItem Header="Mitarbeiterkarte" Click="WorkTimeEmployeeCardContext_Click"/>
                                    <MenuItem Header="Skills / Stammdaten" Click="WorkTimeEmployeeMasterContext_Click"/>
                                    <MenuItem Header="Aktuell geplant" Click="WorkTimeEmployeePlanContext_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="100"/>
                                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="105"/>
                                    <DataGridTextColumn Header="Pause" Binding="{Binding BreakMinutes}" Width="65"/>
                                    <DataGridTextColumn Header="Netto h" Binding="{Binding NetHours, StringFormat=0.00}" Width="75"/>
                                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource EditorCardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Arbeitszeit erfassen" Style="{StaticResource DialogTitleTextStyle}" Margin="0,0,0,14"/>
                                <TextBlock Text="Mitarbeiter" Style="{StaticResource FieldLabelTextStyle}"/>
                                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,0,12"/>
                                <TextBlock Text="Datum" Style="{StaticResource FieldLabelTextStyle}"/>
                                <DatePicker SelectedDate="{Binding EntryDate, Mode=TwoWay}" Margin="0,0,0,12"/>
                                <TextBlock Text="Start (HH:mm)" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                <TextBlock Text="Ende (HH:mm)" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                <TextBlock Text="Pause Minuten" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBox Text="{Binding BreakMinutes}" Margin="0,0,0,12"/>
                                <TextBlock Text="Kommentar" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBox Text="{Binding EntryComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14" VerticalScrollBarVisibility="Auto"/>
                                <Button Content="Speichern" Command="{Binding SaveEntryCommand}" Margin="0,0,0,7" Style="{StaticResource PrimaryActionButtonStyle}"/>
                                <Button Content="Neu" Command="{Binding NewEntryCommand}" Margin="0,0,0,7" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="In Papierkorb" Command="{Binding DeleteEntryCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Betriebskalender">
                <Grid Margin="14,16,14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SectionCardStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Kalender-Ausnahmen" Style="{StaticResource SectionHeaderTextStyle}"/>
                            <TextBlock Text="Ohne Ausnahme gilt automatisch Montag bis Freitag als Arbeitstag. Hinterlege hier Feiertage, Betriebsferien, halbe Tage oder Sonderarbeitstage." Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,10"/>
                            <DataGrid ItemsSource="{Binding CalendarDays}" SelectedItem="{Binding SelectedCalendarDay, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="120"/>
                                    <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Typ" Binding="{Binding WorkingDayText}" Width="90"/>
                                    <DataGridTextColumn Header="Soll-Faktor" Binding="{Binding FactorText}" Width="85"/>
                                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Kalendertag bearbeiten" Style="{StaticResource DialogTitleTextStyle}" Margin="0,0,0,14"/>
                            <TextBlock Text="Datum" Style="{StaticResource FieldLabelTextStyle}"/>
                            <DatePicker SelectedDate="{Binding CalendarDate, Mode=TwoWay}" Margin="0,0,0,12"/>
                            <TextBlock Text="Bezeichnung" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox Text="{Binding CalendarName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <CheckBox Content="Arbeitstag / Sonderarbeitstag" IsChecked="{Binding CalendarIsWorkingDay}" Margin="0,2,0,12"/>
                            <TextBlock Text="Sollstunden-Faktor" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox Text="{Binding CalendarTargetHoursFactor}" Margin="0,0,0,5"/>
                            <TextBlock Text="0 = frei · 0.5 = halber Tag · 1 = normal · bis 2 möglich" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,12"/>
                            <TextBlock Text="Kommentar" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox Text="{Binding CalendarComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14" VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Speichern" Command="{Binding SaveCalendarDayCommand}" Margin="0,0,0,7" Style="{StaticResource PrimaryActionButtonStyle}"/>
                            <Button Content="Neu" Command="{Binding NewCalendarDayCommand}" Margin="0,0,0,7" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Ausnahme archivieren" Command="{Binding DeleteCalendarDayCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>