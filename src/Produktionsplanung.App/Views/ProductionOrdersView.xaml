<UserControl x:Class="Produktionsplanung.App.Views.ProductionOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="28" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Produktionsaufträge" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Aufträge anlegen, planen, besetzen und bis zum Abschluss verfolgen." Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Chargendetails" Click="Details_Click" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="+ Neue Charge" Click="NewBatch_Click" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}" />
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MasterDetailGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <Border x:Name="OrdersListPanel" Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource SectionCardStyle}" Padding="18" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Auftrag, Produkt, Arbeitsplatz, Schicht, Status oder Priorität suchen" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                            <Button Grid.Column="4" Content="Filter zurücksetzen" Command="{Binding ClearFiltersCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <TextBlock Grid.Column="6" Text="{Binding OrderFilterSummary}" Style="{StaticResource SecondaryTextStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding OrdersView}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Auftrag" Binding="{Binding OrderNumber}" Width="100" />
                                            <DataGridTextColumn Header="Artikel" Binding="{Binding ArticleNumber}" Width="105" />
                                            <DataGridTextColumn Header="Produkt" Binding="{Binding Product}" Width="1.25*" />
                                            <DataGridTextColumn Header="Charge" Binding="{Binding BatchNumber}" Width="105" />
                                            <DataGridTextColumn Header="Start" Binding="{Binding PlannedDate, StringFormat=dd.MM.yyyy}" Width="96" />
                                            <DataGridTextColumn Header="Maschine / Ort" Binding="{Binding WorkstationName}" Width="1.25*" />
                                            <DataGridTextColumn Header="Startschicht" Binding="{Binding ShiftName}" Width="110" />
                                            <DataGridTextColumn Header="Lauf" Binding="{Binding RunText}" Width="95" />
                                            <DataGridTextColumn Header="Menge" Binding="{Binding QuantityText}" Width="95" />
                                            <DataGridTextColumn Header="Personal" Binding="{Binding RequiredStaff}" Width="66" />
                                            <DataGridTemplateColumn Header="Status" Width="125">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="StatusChip" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                            <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Geplant">
                                                                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                                                <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource InfoBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="In Produktion">
                                                                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                                <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Fertig">
                                                                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Storniert">
                                                                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                                <Setter TargetName="StatusChip" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="OrderEditorPanel" Grid.Row="0" Grid.Column="1" Style="{StaticResource EditorCardStyle}" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Auftrag bearbeiten" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Die Laufdauer kann mehrere aufeinanderfolgende Schichten umfassen. SolutionCompakt erzeugt die Schichtfolge automatisch."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,18" />

                        <TextBlock Text="Auftragsnummer" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding OrderNumber, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12" />

                        <TextBlock Text="Produkt" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Product, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Artikelnummer" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ArticleNumber, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Charge / Los" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Menge" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Einheit" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" Height="34" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Priorität" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority, Mode=TwoWay}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status, Mode=TwoWay}" Height="34" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,2,0,14">
                            <StackPanel>
                                <TextBlock Text="Produktionslauf" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                <TextBlock Text="Startdatum und Startschicht festlegen. Bei mehreren Schichten läuft das Produkt automatisch in der zeitlichen Schichtfolge weiter."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,12" />

                                <TextBlock Text="Startdatum" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <DatePicker SelectedDate="{Binding PlannedDate, Mode=TwoWay}" Height="34" Margin="0,0,0,10" />

                                <TextBlock Text="Maschine / Ort" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedWorkstation, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Startschicht" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="34" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Laufdauer (Schichten)" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding PlannedShiftCount, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Beispiel: 7 bedeutet sieben aufeinanderfolgende Schichten; bei einem 3-Schicht-System also mehr als zwei Produktionstage."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Automatische Schichtfolge" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding RunScheduleSummary}" Foreground="{StaticResource PrimaryBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding RunSchedulePreview}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="88"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="84"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SequenceNumber}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ShiftName}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="3" Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Personalbedarf pro Schicht" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding RequiredStaff, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12" />

                        <TextBlock Text="Beschreibung" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="Kommentar" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Produktionsauftrag und Produktionsschichten gespeichert.">
                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Produktionsauftrag aktualisiert; bestehende Produktionsschichten blieben unverändert.">
                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Auftrag aktualisiert; historische Stammdaten und Produktionsschichten blieben unverändert.">
                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Produktionsauftrag gelöscht.">
                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Produktionsaufträge aktualisiert.">
                                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="Produktionsauftrag und Produktionsschichten gespeichert."><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="Produktionsauftrag aktualisiert; bestehende Produktionsschichten blieben unverändert."><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="Auftrag aktualisiert; historische Stammdaten und Produktionsschichten blieben unverändert."><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="Produktionsauftrag gelöscht."><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="Produktionsaufträge aktualisiert."><Setter Property="Foreground" Value="{StaticResource InfoBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Button Content="Speichern" Command="{Binding SaveCommand}" Margin="0,0,0,8" Style="{StaticResource PrimaryActionButtonStyle}" />
                        <Button Content="Neue Charge" Click="NewBatch_Click" Margin="0,0,0,8" Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="Ausgewählten Auftrag löschen" Command="{Binding DeleteCommand}" Style="{StaticResource DangerActionButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
