<UserControl x:Class="Produktionsplanung.App.Views.ManufacturingControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <Style x:Key="WorkflowStepStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Done">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Auftragscockpit" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Auftrag → Planung → Besetzung → Arbeitsgänge → Produktion → Qualität → Abschluss"
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↻ Aktualisieren" Command="{Binding RefreshCommand}"
                    Height="36" Padding="14,0" VerticalAlignment="Center"/>
        </Grid>

        <TabControl Grid.Row="2">

            <!-- 1. AUFTRAGS-COCKPIT -->
            <TabItem Header="Statusboard &amp; Übersicht">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Aufträge im Cockpit" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    <TextBlock Text="Status, Fortschritt und nächster Arbeitsschritt" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Nur Handlungsbedarf" IsChecked="{Binding ShowOnlyActionNeeded}" VerticalAlignment="Center"/>
                            </Grid>

                            <ListBox Grid.Row="2" ItemsSource="{Binding CockpitOrders}" SelectedItem="{Binding SelectedCockpitOrder, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="OrderCard" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="9" Padding="12" Margin="0,0,0,8" Background="{StaticResource CardBrush}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" FontSize="14"/>
                                                    <Border Grid.Column="1" x:Name="OrderChip" Style="{StaticResource StatusChipStyle}">
                                                        <TextBlock x:Name="OrderChipText" Text="{Binding ReadinessText}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Product}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding WorkstationName, StringFormat='Arbeitsplatz: {0}'}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding CurrentOperation}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="7"/>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryTextStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding IssueText}" Style="{StaticResource SecondaryTextStyle}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ReadinessKind}" Value="Success">
                                                <Setter TargetName="OrderChip" Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                <Setter TargetName="OrderChip" Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                <Setter TargetName="OrderChipText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ReadinessKind}" Value="Warning">
                                                <Setter TargetName="OrderChip" Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                <Setter TargetName="OrderChip" Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                <Setter TargetName="OrderChipText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ReadinessKind}" Value="Danger">
                                                <Setter TargetName="OrderChip" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                <Setter TargetName="OrderChip" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                <Setter TargetName="OrderChipText" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedCockpitOrder.OrderNumber}" FontSize="22" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedCockpitOrder.Product}" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="12,6" CornerRadius="9" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReadinessStatusKind}" Value="Success"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ReadinessStatusKind}" Value="Warning"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ReadinessStatusKind}" Value="Danger"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ReadinessStatusText}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding OrderProgressPercent}" Height="10" Margin="0,16,0,4"/>
                                    <TextBlock Text="{Binding OrderProgressText}" Style="{StaticResource SecondaryTextStyle}"/>

                                    <UniformGrid Columns="5" Margin="0,18,0,0">
                                        <Border Style="{StaticResource WorkflowStepStyle}" Tag="{Binding WorkflowPlanState}"><StackPanel><TextBlock Text="1" FontWeight="Bold"/><TextBlock Text="Geplant" FontWeight="SemiBold"/></StackPanel></Border>
                                        <Border Style="{StaticResource WorkflowStepStyle}" Tag="{Binding WorkflowReadyState}"><StackPanel><TextBlock Text="2" FontWeight="Bold"/><TextBlock Text="Bereit" FontWeight="SemiBold"/></StackPanel></Border>
                                        <Border Style="{StaticResource WorkflowStepStyle}" Tag="{Binding WorkflowProductionState}"><StackPanel><TextBlock Text="3" FontWeight="Bold"/><TextBlock Text="Produktion" FontWeight="SemiBold"/></StackPanel></Border>
                                        <Border Style="{StaticResource WorkflowStepStyle}" Tag="{Binding WorkflowQualityState}"><StackPanel><TextBlock Text="4" FontWeight="Bold"/><TextBlock Text="QS" FontWeight="SemiBold"/></StackPanel></Border>
                                        <Border Style="{StaticResource WorkflowStepStyle}" Tag="{Binding WorkflowDoneState}" Margin="0"><StackPanel><TextBlock Text="5" FontWeight="Bold"/><TextBlock Text="Fertig" FontWeight="SemiBold"/></StackPanel></Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Produktionsbereitschaft" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding WorkstationReadinessText}" Margin="0,3"/>
                                        <TextBlock Text="{Binding CapacityReadinessText}" Margin="0,3"/>
                                        <TextBlock Text="{Binding StaffReadinessText}" Margin="0,3"/>
                                        <TextBlock Text="{Binding SkillReadinessText}" Margin="0,3"/>
                                        <TextBlock Text="{Binding MaterialReadinessText}" Margin="0,3" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Aktueller Workflow" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Aktuell" Style="{StaticResource EyebrowTextStyle}"/>
                                        <TextBlock Text="{Binding CurrentOperationText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,12"/>
                                        <TextBlock Text="Danach" Style="{StaticResource EyebrowTextStyle}"/>
                                        <TextBlock Text="{Binding NextOperationText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Arbeitsgang-Prozess" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding JobCards}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding SequenceNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding OperationName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding WorkstationName}" Style="{StaticResource SecondaryTextStyle}"/>
                                                        <TextBlock Text="{Binding EmployeeName, StringFormat='Mitarbeiter: {0}'}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" x:Name="ProcessStatus" Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Right">
                                                        <TextBlock x:Name="ProcessStatusText" Text="{Binding Status}" FontWeight="SemiBold" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Fertig"><Setter TargetName="ProcessStatus" Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter TargetName="ProcessStatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="In Produktion"><Setter TargetName="ProcessStatus" Property="Background" Value="{StaticResource InfoSoftBrush}"/><Setter TargetName="ProcessStatusText" Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pausiert"><Setter TargetName="ProcessStatus" Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter TargetName="ProcessStatusText" Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 2. ARBEITSKARTEN -->
            <TabItem Header="Arbeitskarten">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource FilterBarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ProductionOrders}" SelectedItem="{Binding SelectedProductionOrder, Mode=TwoWay}" DisplayMemberPath="DisplayName" MinWidth="420"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Prozess" Command="{Binding ShowProcessCommand}" Margin="0,0,6,0"/>
                                <Button Content="Tabelle" Command="{Binding ShowTableCommand}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Arbeitskarten erzeugen" Command="{Binding GenerateJobCardsCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding ShowProcessView}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding JobCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectJobCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,10">
                                                <Border x:Name="JobProcessCard" Padding="16" CornerRadius="10" BorderThickness="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource PrimarySoftBrush}">
                                                            <TextBlock Text="{Binding SequenceNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding OperationName}" FontSize="16" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding WorkstationName}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding EmployeeName, StringFormat='Mitarbeiter: {0}'}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding RequirementText, StringFormat='Skill: {0}'}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                            <Border x:Name="CardStatusChip" Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Right">
                                                                <TextBlock x:Name="CardStatusText" Text="{Binding Status}" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Fertig"><Setter TargetName="CardStatusChip" Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter TargetName="CardStatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="In Produktion"><Setter TargetName="CardStatusChip" Property="Background" Value="{StaticResource InfoSoftBrush}"/><Setter TargetName="CardStatusText" Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pausiert"><Setter TargetName="CardStatusChip" Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter TargetName="CardStatusText" Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding ShowProcessView}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DataGrid ItemsSource="{Binding JobCards}" SelectedItem="{Binding SelectedJobCard, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="50"/>
                                        <DataGridTextColumn Header="Arbeitsgang" Binding="{Binding OperationName}" Width="*"/>
                                        <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="130"/>
                                        <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="150"/>
                                        <DataGridTextColumn Header="Skill" Binding="{Binding RequirementText}" Width="140"/>
                                        <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="110"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Arbeitskarte" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding SelectedJobCard.OperationName}" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedJobCard.WorkstationName}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,8"/>
                                    <TextBlock Text="{Binding SelectedJobCard.RequirementText, StringFormat='Pflichtqualifikation: {0}'}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding JobCardEmployeeChoices}" SelectedItem="{Binding SelectedJobCardEmployeeChoice, Mode=TwoWay}" DisplayMemberPath="DisplayText"/>
                                        <Button Grid.Column="2" Content="Beste Wahl" Command="{Binding AutoAssignBestEmployeeCommand}" ToolTip="Skill, Abwesenheit, Planung und aktive Arbeitskarten berücksichtigen"/>
                                    </Grid>

                                    <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,14" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QualificationStatusKind}" Value="Success"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding QualificationStatusKind}" Value="Warning"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding QualificationStatusKind}" Value="Danger"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding QualificationStatusText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <Button Content="▶ Start / Weiter" Command="{Binding StartJobCardCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="44" Margin="0,0,6,0"/>
                                        <Button Content="⏸ Pause" Command="{Binding PauseJobCardCommand}" Height="44" Margin="6,0,0,0"/>
                                    </UniformGrid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Gutmenge" FontWeight="SemiBold"/><TextBox Text="{Binding FinishGoodQuantity}" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Ausschuss" FontWeight="SemiBold"/><TextBox Text="{Binding FinishScrapQuantity}" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>

                                    <TextBlock Text="Kommentar" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding JobCardComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,5,0,12"/>
                                    <Button Content="✓ Arbeitsgang fertig → nächster Schritt" Command="{Binding FinishJobCardCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="44"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 3. KAPAZITÄT -->
            <TabItem Header="Kapazität">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kapazitätsvorschau · nächste 7 Tage" Style="{StaticResource SectionHeaderTextStyle}"/>
                            <TextBlock Text="Arbeitsplatz anklicken, um die verursachenden Arbeitskarten zu sehen." Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Neu berechnen" Command="{Binding RefreshCapacityCommand}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding CapacityRows}" SelectedItem="{Binding SelectedCapacityRow, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CapacityCard" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,9" Padding="14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WorkstationName}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding Area}" Style="{StaticResource SecondaryTextStyle}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" x:Name="CapacityChip" Style="{StaticResource StatusChipStyle}">
                                                    <TextBlock x:Name="CapacityChipText" Text="{Binding Status}" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="120" Value="{Binding BarValue}" Height="10" Margin="0,12,0,5"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding UtilizationText}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DeltaText}" Style="{StaticResource SecondaryTextStyle}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding PlannedText, StringFormat='Geplant: {0}'}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding AvailableText, StringFormat='Verfügbar: {0}'}" Style="{StaticResource SecondaryTextStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Frei"><Setter TargetName="CapacityChip" Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter TargetName="CapacityChipText" Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Knapp"><Setter TargetName="CapacityChip" Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter TargetName="CapacityChipText" Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Überlastet"><Setter TargetName="CapacityChip" Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter TargetName="CapacityChipText" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCapacityRow.WorkstationName, StringFormat='Belastung durch Arbeitskarten · {0}'}" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding CapacityJobCards}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Datum" Binding="{Binding PlannedDate, StringFormat=dd.MM.}" Width="70"/>
                                        <DataGridTextColumn Header="Auftrag" Binding="{Binding OrderNumber}" Width="95"/>
                                        <DataGridTextColumn Header="Arbeitsgang" Binding="{Binding OperationName}" Width="*"/>
                                        <DataGridTextColumn Header="Soll" Binding="{Binding PlannedMinutes, StringFormat={}{0:N0} min}" Width="75"/>
                                        <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 4. STAMMDATEN -->
            <TabItem Header="Stammdaten">
                <TabControl Margin="14">
                    <TabItem Header="Arbeitsgänge">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                                <DataGrid ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                                        <DataGridTextColumn Header="Arbeitsgang" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Soll min" Binding="{Binding DefaultMinutes, StringFormat=N0}" Width="80"/>
                                        <DataGridTextColumn Header="Personal" Binding="{Binding RequiredStaff}" Width="70"/>
                                        <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Arbeitsgang definieren" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,14"/>
                                        <TextBlock Text="Code" FontWeight="SemiBold"/><TextBox Text="{Binding OperationCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                                        <TextBlock Text="Bezeichnung" FontWeight="SemiBold"/><TextBox Text="{Binding OperationName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                                        <TextBlock Text="Beschreibung" FontWeight="SemiBold"/><TextBox Text="{Binding OperationDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,5,0,10"/>
                                        <TextBlock Text="Standard-Arbeitsplatz" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedDefaultWorkstation, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,5,0,10"/>
                                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Sollzeit (min)" FontWeight="SemiBold"/><TextBox Text="{Binding DefaultMinutes}" Margin="0,5,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Personalbedarf" FontWeight="SemiBold"/><TextBox Text="{Binding OperationRequiredStaff}" Margin="0,5,0,0"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="Pflichtqualifikation" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Qualifications}" SelectedItem="{Binding SelectedRequiredQualification, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,5,0,10"/>
                                        <TextBlock Text="Mindest-Level" FontWeight="SemiBold"/><TextBox Text="{Binding RequiredQualificationLevel}" Margin="0,5,0,10"/>
                                        <CheckBox Content="Arbeitsgang aktiv" IsChecked="{Binding OperationIsActive}" Margin="0,0,0,16"/>
                                        <WrapPanel><Button Content="Neu" Command="{Binding NewOperationCommand}" Margin="0,0,8,0"/><Button Content="Speichern" Command="{Binding SaveOperationCommand}" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Arbeitspläne">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DataGrid ItemsSource="{Binding Routings}" SelectedItem="{Binding SelectedRouting, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns><DataGridTextColumn Header="Produkt" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Arbeitsplan" Binding="{Binding Name}" Width="*"/></DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="1" Content="+ Neuer Arbeitsplan" Command="{Binding NewRoutingCommand}" Margin="0,10,0,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Produkt" FontWeight="SemiBold"/><TextBox Text="{Binding RoutingProduct, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Name des Arbeitsplans" FontWeight="SemiBold"/><TextBox Text="{Binding RoutingName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom"><CheckBox Content="Aktiv" IsChecked="{Binding RoutingIsActive}" Margin="0,0,0,8"/><Button Content="Speichern" Command="{Binding SaveRoutingCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                                    </Grid>

                                    <DataGrid x:Name="RoutingStepsGrid" Grid.Row="2" ItemsSource="{Binding RoutingSteps}" AutoGenerateColumns="False" IsReadOnly="True"
                                              AllowDrop="True" PreviewMouseLeftButtonDown="RoutingStepsGrid_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="RoutingStepsGrid_PreviewMouseMove" Drop="RoutingStepsGrid_Drop">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="☰" Width="35"/>
                                            <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="55"/>
                                            <DataGridTextColumn Header="Code" Binding="{Binding OperationCode}" Width="80"/>
                                            <DataGridTextColumn Header="Arbeitsgang" Binding="{Binding OperationName}" Width="*"/>
                                            <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="150"/>
                                            <DataGridTextColumn Header="Soll min" Binding="{Binding PlannedMinutes, StringFormat=N0}" Width="75"/>
                                            <DataGridTextColumn Header="Personal" Binding="{Binding RequiredStaff}" Width="70"/>
                                            <DataGridTemplateColumn Header="" Width="70">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Löschen" Command="{Binding DataContext.DeleteRoutingStepCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="7,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="4" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedStepOperation, Mode=TwoWay}" DisplayMemberPath="Name"/>
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedStepWorkstation, Mode=TwoWay}" DisplayMemberPath="Name"/>
                                            <TextBox Grid.Column="4" Text="{Binding StepMinutes}" ToolTip="Sollzeit in Minuten"/>
                                            <TextBox Grid.Column="6" Text="{Binding StepRequiredStaff}" ToolTip="Personalbedarf"/>
                                            <StackPanel Grid.Column="8" Orientation="Horizontal"><Button Content="Standard" Command="{Binding UseOperationDefaultsCommand}" Margin="0,0,8,0"/><Button Content="+ Schritt" Command="{Binding AddRoutingStepCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,7" CornerRadius="8"
                Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>