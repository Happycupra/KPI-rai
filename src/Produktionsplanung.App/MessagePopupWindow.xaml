<Window x:Class="Produktionsplanung.App.MessagePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolutionCompakt – Neuer Hinweis"
        Icon="{StaticResource SolutionCompaktIcon}"
        Width="540" Height="440" MinWidth="500" MinHeight="390"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SurfaceBrush}" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Top">
                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Neuer Hinweis" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding Partner, StringFormat=Von: {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding CreatedText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="10" Padding="10,5"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Priority}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Subject}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Body}" FontSize="14" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" LineHeight="21"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="Später" Click="Later_Click" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="Gelesen bestätigen" Click="Acknowledge_Click" IsDefault="True"
                    Style="{StaticResource PrimaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>