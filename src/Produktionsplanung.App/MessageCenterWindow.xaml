<Window x:Class="Produktionsplanung.App.MessageCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolutionCompakt – Hinweise"
        Icon="{StaticResource SolutionCompaktIcon}"
        Width="1040" Height="720" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Hinweise" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Persönliche Nachrichten zwischen angemeldeten SolutionCompakt-Benutzern."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Aktualisieren" Click="Refresh_Click"
                    VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}"/>
        </Grid>

        <TabControl Grid.Row="1" x:Name="MessageTabs">
            <TabItem Header="Posteingang">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

                    <DataGrid x:Name="InboxGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="InboxGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAcknowledged}" Value="False">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding CreatedText}" Width="135"/>
                            <DataGridTextColumn Header="Von" Binding="{Binding Partner}" Width="160"/>
                            <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Priorität" Binding="{Binding Priority}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="125"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Hinweis" Style="{StaticResource SectionHeaderTextStyle}"/>
                            <TextBlock x:Name="InboxMeta" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InboxSubject" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                <TextBlock x:Name="InboxBody" TextWrapping="Wrap" LineHeight="20"/>
                            </ScrollViewer>
                            <Button x:Name="AcknowledgeButton" Content="Gelesen bestätigen" Click="AcknowledgeSelected_Click"
                                    Margin="0,18,0,0" HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryActionButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Gesendet">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

                    <DataGrid x:Name="SentGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="SentGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding CreatedText}" Width="135"/>
                            <DataGridTextColumn Header="An" Binding="{Binding Partner}" Width="160"/>
                            <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Priorität" Binding="{Binding Priority}" Width="90"/>
                            <DataGridTextColumn Header="Lesebestätigung" Binding="{Binding StatusText}" Width="190"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Gesendeter Hinweis" Style="{StaticResource SectionHeaderTextStyle}"/>
                            <TextBlock x:Name="SentMeta" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SentSubject" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                <TextBlock x:Name="SentBody" TextWrapping="Wrap" LineHeight="20"/>
                            </ScrollViewer>
                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="8" Padding="10" Margin="0,18,0,0">
                                <TextBlock x:Name="SentStatus" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Neue Nachricht">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22" MaxWidth="680" HorizontalAlignment="Center">
                        <TextBlock Text="Neuen Hinweis senden" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="Empfänger" FontWeight="SemiBold"/>
                        <ComboBox x:Name="RecipientBox" DisplayMemberPath="DisplayText" Margin="0,5,0,14" Height="36"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Betreff" FontWeight="SemiBold"/>
                                <TextBox x:Name="SubjectBox" MaxLength="120" Margin="0,5,0,0" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Priorität" FontWeight="SemiBold"/>
                                <ComboBox x:Name="PriorityBox" Margin="0,5,0,0" Height="36">
                                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                                    <ComboBoxItem Content="Wichtig"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nachricht" FontWeight="SemiBold"/>
                        <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                                 MinHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,5,0,8"/>
                        <TextBlock Text="Der Empfänger erhält ein Popup und bestätigt den Hinweis ausdrücklich als gelesen."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Button Content="Hinweis senden" Click="Send_Click" HorizontalAlignment="Center"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Schliessen" Click="Close_Click" Style="{StaticResource ActionButtonStyle}"/>
        </Grid>
    </Grid>
</Window>