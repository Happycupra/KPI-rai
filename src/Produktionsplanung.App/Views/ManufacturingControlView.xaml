<UserControl x:Class="Produktionsplanung.App.Views.ManufacturingControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Fertigungssteuerung" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Arbeitsgänge, Arbeitspläne, Arbeitskarten und Kapazität in einem durchgängigen Produktionsablauf."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Aktualisieren" Command="{Binding RefreshCommand}"
                    Height="34" Padding="14,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0">
                <TabItem Header="1 · Arbeitsgänge">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="16">
                            <DataGrid ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                                    <DataGridTextColumn Header="Arbeitsgang" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Soll min" Binding="{Binding DefaultMinutes, StringFormat=N0}" Width="80"/>
                                    <DataGridTextColumn Header="Personal" Binding="{Binding RequiredStaff}" Width="70"/>
                                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Arbeitsgang definieren" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="Code" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding OperationCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                                    <TextBlock Text="Bezeichnung" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding OperationName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                                    <TextBlock Text="Beschreibung" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding OperationDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="54" Margin="0,5,0,10"/>
                                    <TextBlock Text="Standard-Arbeitsplatz" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedDefaultWorkstation, Mode=TwoWay}"
                                              DisplayMemberPath="Name" Margin="0,5,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Sollzeit (min)" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding DefaultMinutes}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Personalbedarf" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding OperationRequiredStaff}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Pflichtqualifikation" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Qualifications}" SelectedItem="{Binding SelectedRequiredQualification, Mode=TwoWay}"
                                              DisplayMemberPath="Name" Margin="0,5,0,10"/>
                                    <TextBlock Text="Mindest-Level" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding RequiredQualificationLevel}" Margin="0,5,0,10"/>
                                    <CheckBox Content="Arbeitsgang aktiv" IsChecked="{Binding OperationIsActive}" Margin="0,0,0,16"/>
                                    <WrapPanel>
                                        <Button Content="Neu" Command="{Binding NewOperationCommand}" Margin="0,0,8,0" Padding="14,7"/>
                                        <Button Content="Speichern" Command="{Binding SaveOperationCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="2 · Arbeitspläne">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DataGrid ItemsSource="{Binding Routings}" SelectedItem="{Binding SelectedRouting, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Produkt" Binding="{Binding Product}" Width="*"/>
                                        <DataGridTextColumn Header="Arbeitsplan" Binding="{Binding Name}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="1" Content="+ Neuer Arbeitsplan" Command="{Binding NewRoutingCommand}" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Produkt" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding RoutingProduct, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Name des Arbeitsplans" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding RoutingName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                        <CheckBox Content="Aktiv" IsChecked="{Binding RoutingIsActive}" Margin="0,0,0,8"/>
                                        <Button Content="Arbeitsplan speichern" Command="{Binding SaveRoutingCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="2" ItemsSource="{Binding RoutingSteps}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="55"/>
                                        <DataGridTextColumn Header="Code" Binding="{Binding OperationCode}" Width="80"/>
                                        <DataGridTextColumn Header="Arbeitsgang" Binding="{Binding OperationName}" Width="*"/>
                                        <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="150"/>
                                        <DataGridTextColumn Header="Soll min" Binding="{Binding PlannedMinutes, StringFormat=N0}" Width="75"/>
                                        <DataGridTextColumn Header="Personal" Binding="{Binding RequiredStaff}" Width="70"/>
                                        <DataGridTemplateColumn Header="" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Löschen"
                                                            Command="{Binding DataContext.DeleteRoutingStepCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" Padding="7,3"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="4" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedStepOperation, Mode=TwoWay}" DisplayMemberPath="Name"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedStepWorkstation, Mode=TwoWay}" DisplayMemberPath="Name"/>
                                        <TextBox Grid.Column="4" Text="{Binding StepMinutes}" ToolTip="Sollzeit in Minuten"/>
                                        <TextBox Grid.Column="6" Text="{Binding StepRequiredStaff}" ToolTip="Personalbedarf"/>
                                        <StackPanel Grid.Column="8" Orientation="Horizontal">
                                            <Button Content="Standard" Command="{Binding UseOperationDefaultsCommand}" Margin="0,0,8,0"/>
                                            <Button Content="+ Schritt" Command="{Binding AddRoutingStepCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="3 · Arbeitskarten">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource FilterBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding ProductionOrders}" SelectedItem="{Binding SelectedProductionOrder, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" MinWidth="420"/>
                                <Button Grid.Column="2" Content="Arbeitskarten aus Arbeitsplan erzeugen" Command="{Binding GenerateJobCardsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="14,7"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="14">
                                <DataGrid ItemsSource="{Binding JobCards}" SelectedItem="{Binding SelectedJobCard, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="50"/>
                                        <DataGridTextColumn Header="Arbeitsgang" Binding="{Binding OperationName}" Width="*"/>
                                        <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="130"/>
                                        <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="150"/>
                                        <DataGridTextColumn Header="Skill-Pflicht" Binding="{Binding RequirementText}" Width="145"/>
                                        <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="110"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Arbeitskarte rückmelden" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="{Binding SelectedJobCard.OperationName}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedJobCard.WorkstationName}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8"/>
                                    <TextBlock Text="{Binding SelectedJobCard.RequirementText, StringFormat=Pflichtqualifikation: {0}}"
                                               FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Mitarbeiter" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding JobCardEmployeeChoices}"
                                              SelectedItem="{Binding SelectedJobCardEmployeeChoice, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayText" Margin="0,5,0,10"/>

                                    <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,12" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QualificationStatusKind}" Value="Success">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QualificationStatusKind}" Value="Warning">
                                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QualificationStatusKind}" Value="Danger">
                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding QualificationStatusText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    </Border>

                                    <WrapPanel Margin="0,0,0,14">
                                        <Button Content="▶ Start / Weiter" Command="{Binding StartJobCardCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"/>
                                        <Button Content="⏸ Pause" Command="{Binding PauseJobCardCommand}" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Gutmenge" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding FinishGoodQuantity}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Ausschuss" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding FinishScrapQuantity}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Kommentar" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding JobCardComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="70" Margin="0,5,0,14"/>
                                    <Button Content="✓ Arbeitsgang fertig" Command="{Binding FinishJobCardCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="4 · Kapazität">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kapazitätsvorschau · nächste 7 Tage" Style="{StaticResource SectionHeaderTextStyle}"/>
                                <TextBlock Text="Geplante offene Arbeitskarten werden gegen die freigegebenen Arbeitsplatz-Schichten gerechnet."
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Neu berechnen" Command="{Binding RefreshCapacityCommand}"/>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="14">
                            <DataGrid ItemsSource="{Binding CapacityRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="*"/>
                                    <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="160"/>
                                    <DataGridTextColumn Header="Kapazität" Binding="{Binding AvailableText}" Width="110"/>
                                    <DataGridTextColumn Header="Geplant" Binding="{Binding PlannedText}" Width="110"/>
                                    <DataGridTextColumn Header="Offene Karten" Binding="{Binding OpenJobCards}" Width="100"/>
                                    <DataGridTextColumn Header="Auslastung" Binding="{Binding UtilizationText}" Width="110"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="1" Margin="0,12,0,0" Padding="10,7" CornerRadius="8"
                    Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
