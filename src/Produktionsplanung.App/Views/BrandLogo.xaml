<UserControl x:Class="Produktionsplanung.App.Views.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="205" Height="58">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Width="46" Height="46" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border CornerRadius="10" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="2"/>
            <Border Margin="7,11,7,7" CornerRadius="4" BorderBrush="#0F3B67" BorderThickness="2"/>
            <Rectangle Width="4" Height="11" RadiusX="2" RadiusY="2" Fill="#0F3B67" HorizontalAlignment="Left" Margin="13,1,0,0" VerticalAlignment="Top"/>
            <Rectangle Width="4" Height="11" RadiusX="2" RadiusY="2" Fill="#0F3B67" HorizontalAlignment="Right" Margin="0,1,13,0" VerticalAlignment="Top"/>
            <Path Data="M 12 29 L 19 35 L 34 20" Stroke="#16A34A" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
            <TextBlock FontSize="23" FontWeight="Bold" Foreground="#0F172A">
                <Run Text="Ops"/><Run Text="Compact" Foreground="#2563EB"/>
            </TextBlock>
            <TextBlock Text="Planen · Produzieren · Verbessern" FontSize="9.5" Foreground="#64748B" Margin="0,1,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
