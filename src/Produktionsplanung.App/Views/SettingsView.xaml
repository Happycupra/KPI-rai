<UserControl x:Class="Produktionsplanung.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Einstellungen" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Unternehmensdaten, Sicherheit, Datensicherung und Exporte verwalten." FontSize="15" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Einstellungen speichern" Height="36" Padding="16,0"
                        VerticalAlignment="Center" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Unternehmen" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="Diese Angaben dienen als lokale Anwendungseinstellungen und können später für Berichte/Exporte verwendet werden."
                                   Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,16" />

                        <TextBlock Text="Firmenname" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,0,12" />

                        <TextBlock Text="Standort / Werk" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" Height="34" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Lokale Speicherorte" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="SolutionCompakt speichert die operative Datenbank lokal. Der bisherige Datenpfad bleibt aus Kompatibilitätsgründen erhalten."
                                   Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,16" />

                        <TextBlock Text="Datenbank" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DatabasePath}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,10" />
                        <TextBlock Text="Einstellungen" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SettingsPath}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,14" />
                        <Button Content="Datenordner öffnen" Height="34" Padding="14,0" HorizontalAlignment="Left"
                                Command="{Binding OpenDataDirectoryCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Backup &amp; Wiederherstellung" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Text="Ein .kpibackup enthält einen konsistenten SQLite-Snapshot, die Anwendungseinstellungen und Backup-Metadaten. Die Dateiendung bleibt mit bisherigen Backups kompatibel. Vor jeder Wiederherstellung wird automatisch ein zusätzliches Sicherheitsbackup erstellt."
                               Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Backup-Ordner" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Column="1" Text="{Binding DefaultBackupDirectory, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Auswählen" Height="34" Padding="12,0" Margin="0,0,8,0"
                                Command="{Binding BrowseBackupDirectoryCommand}" />
                        <Button Grid.Column="3" Content="Öffnen" Height="34" Padding="12,0"
                                Command="{Binding OpenBackupDirectoryCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="1" Content="Auto-Backup beim Beenden" IsChecked="{Binding AutoBackupOnExit}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Behalten:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding BackupRetentionCount, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="30" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="Automatische Backups werden nach Anzahl begrenzt; manuelle Sicherheitsbackups werden nicht automatisch gelöscht."
                                   Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Backup jetzt erstellen" Height="36" Padding="16,0" Margin="0,0,8,0"
                                Command="{Binding CreateBackupCommand}" />
                        <Button Content="Backup wiederherstellen" Height="36" Padding="16,0" Margin="0,0,8,0"
                                Command="{Binding RestoreBackupCommand}" />
                        <Button Content="SolutionCompakt neu starten" Height="36" Padding="16,0"
                                Command="{Binding RestartApplicationCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="18" Foreground="#1D4ED8" Margin="0,1,9,0" />
                            <TextBlock Text="Sicherheit &amp; Recovery" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
                        </StackPanel>
                        <TextBlock Text="Der Recovery-Code ist der Notfallzugang für ein vergessenes Passwort. Er wird nur gehasht gespeichert und kann nicht aus der App ausgelesen werden."
                                   Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <TextBlock Text="{Binding RecoveryCodeStatus}" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBlock Text="Beim Erneuern wird der bisherige Code sofort ungültig. Das aktuelle Administrator-Passwort muss erneut bestätigt werden."
                                   Foreground="#9A3412" TextWrapping="Wrap" Margin="0,6,24,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Recovery-Code erneuern" Height="38" Padding="16,0" VerticalAlignment="Center"
                            Command="{Binding ManageRecoveryCodeCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="CSV-Export" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Text="Der Komplett-Export erstellt getrennte CSV-Dateien für Mitarbeiter, Skills, Arbeitsplätze, Schichten, Abwesenheiten, Planung, Produktionsaufträge, Ist-Produktion/OEE und Stillstände."
                               Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Export-Ordner" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Column="1" Text="{Binding DefaultExportDirectory, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Auswählen" Height="34" Padding="12,0" Margin="0,0,8,0"
                                Command="{Binding BrowseExportDirectoryCommand}" />
                        <Button Grid.Column="3" Content="Öffnen" Height="34" Padding="12,0"
                                Command="{Binding OpenExportDirectoryCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CSV-Trennzeichen" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBox Grid.Column="1" Text="{Binding CsvDelimiter, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Width="45" Height="30" HorizontalAlignment="Left" />
                        <CheckBox Grid.Column="2" Content="UTF-8 BOM für Excel" IsChecked="{Binding IncludeUtf8Bom}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Standard ist Semikolon; das ist für deutschsprachige Excel-Installationen meist am praktischsten."
                                   Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>

                    <Button Content="Alle Daten als CSV exportieren" Height="36" Padding="16,0" HorizontalAlignment="Left"
                            Command="{Binding ExportAllCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Background="#EFF6FF" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E3A8A" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
