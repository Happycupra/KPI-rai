<Window x:Class="Produktionsplanung.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Produktionsplanung.App.Views"
        Title="SolutionCompakt Anmeldung"
        Icon="{StaticResource SolutionCompaktIcon}"
        Width="520"
        Height="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Border Style="{StaticResource SectionCardStyle}" Padding="28">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">
                    <views:BrandLogo HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <TextBlock x:Name="ModeTitle"
                               Text="Anmeldung"
                               Style="{StaticResource DialogTitleTextStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="ModeDescription"
                               Text="Mit deinem lokalen Benutzerkonto anmelden."
                               Style="{StaticResource PageSubtitleTextStyle}"
                               Margin="0,0,0,20" />

                    <StackPanel x:Name="QuickAccessPanel" Visibility="Collapsed">
                        <Border Background="{StaticResource PrimarySoftBrush}"
                                BorderBrush="{StaticResource InfoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Eingeloggt bleiben ist aktiv" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                <TextBlock x:Name="QuickAccessUserBlock" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="4-stelliger Zugangs-PIN" Style="{StaticResource FieldLabelTextStyle}" />
                        <PasswordBox x:Name="QuickPinBox" MaxLength="4" Margin="0,0,0,8" />
                        <TextBlock Text="Der PIN gilt nur auf diesem Gerät. Das Passwort wird nicht gespeichert."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,12" />
                        <Button Content="Mit Passwort / anderem Konto anmelden"
                                Click="SwitchToPassword_Click"
                                Style="{StaticResource GhostButtonStyle}"
                                Foreground="{StaticResource PrimaryDarkBrush}"
                                HorizontalAlignment="Left"
                                Padding="0,4"
                                Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel x:Name="StandardLoginPanel">
                        <StackPanel x:Name="CompanyPanel" Visibility="Collapsed">
                            <Border Background="{StaticResource PrimarySoftBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <TextBlock Text="Diese Installation wird genau einer Firma zugeordnet. Der Firmen-Code wird später auch für den Online-Login verwendet."
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="Firmenname" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox x:Name="CompanyNameBox" Margin="0,0,0,14" TextChanged="CompanyNameBox_TextChanged" />
                            <TextBlock Text="Firmen-Code" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox x:Name="CompanyCodeBox" Margin="0,0,0,5" TextChanged="CompanyCodeBox_TextChanged" />
                            <TextBlock Text="3–24 Zeichen · Buchstaben, Zahlen und Bindestriche. Beispiel: MUSTER-AG"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,0,0,14" />
                        </StackPanel>

                        <StackPanel x:Name="DisplayNamePanel" Visibility="Collapsed">
                            <TextBlock Text="Anzeigename" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox x:Name="DisplayNameBox" Margin="0,0,0,14" />
                        </StackPanel>

                        <TextBlock Text="Benutzername" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox x:Name="UsernameBox" Margin="0,0,0,14" />

                        <TextBlock Text="Passwort" Style="{StaticResource FieldLabelTextStyle}" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" />

                        <Button x:Name="ForgotPasswordButton"
                                Content="Passwort vergessen?"
                                Click="ForgotPassword_Click"
                                Style="{StaticResource GhostButtonStyle}"
                                Foreground="{StaticResource PrimaryDarkBrush}"
                                HorizontalAlignment="Right"
                                Padding="6,3"
                                Margin="0,0,0,10" />

                        <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed">
                            <TextBlock Text="Passwort bestätigen" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,6" />
                            <TextBlock Text="Mindestens 10 Zeichen, Gross-/Kleinbuchstaben und eine Zahl."
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,0,0,12" />
                        </StackPanel>

                        <CheckBox x:Name="RememberMeCheckBox"
                                  Content="Auf diesem Gerät eingeloggt bleiben"
                                  Checked="RememberMe_Changed"
                                  Unchecked="RememberMe_Changed"
                                  FontWeight="SemiBold"
                                  Margin="0,4,0,4" />
                        <TextBlock Text="Bei späteren Starts genügt dann ein 4-stelliger Zugangs-PIN."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="22,0,0,10" />

                        <StackPanel x:Name="PinSetupPanel" Visibility="Collapsed">
                            <Border Background="{StaticResource PrimarySoftBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <TextBlock Text="PIN einrichten: genau 4 Ziffern. Der PIN wird nur als kryptografischer Prüfwert gespeichert."
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="Zugangs-PIN" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="AccessPinBox" MaxLength="4" Margin="0,0,0,10" />
                            <TextBlock Text="PIN bestätigen" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="ConfirmAccessPinBox" MaxLength="4" Margin="0,0,0,12" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="StatusBlock"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               MinHeight="22"
                               Margin="0,0,0,10"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="SubmitButton"
                            Content="Anmelden"
                            Click="Submit_Click"
                            IsDefault="True"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="Abbrechen"
                            Margin="0,8,0,0"
                            Click="Cancel_Click"
                            IsCancel="True"
                            Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>