<UserControl x:Class="Produktionsplanung.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Einstellungen" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Unternehmensdaten, Datensicherung, Papierkorb, Sicherheit, Export und persönliche Oberfläche verwalten."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Einstellungen speichern"
                    VerticalAlignment="Center" Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource PrimaryActionButtonStyle}" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,14,6,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Unternehmen" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Firmen- und Standortangaben für Berichte und Exporte."
                                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />
                                    <TextBlock Text="Firmenname" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Firmenname" Margin="0,0,0,12" />
                                    <TextBlock Text="Firmen-Code" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding CompanyCode}" IsReadOnly="True"
                                             AutomationProperties.Name="Firmen-Code" Margin="0,0,0,8" />
                                    <TextBlock Text="Stabile Firmen-ID" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding CompanyId}" IsReadOnly="True"
                                             AutomationProperties.Name="Stabile Firmen-ID" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding CompanyRegistrationMode, StringFormat=Registrierung: {0}}"
                                               Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />
                                    <TextBlock Text="Standort / Werk" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Standort oder Werk" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Lokale Speicherorte" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Die operative Datenbank und Anwendungseinstellungen liegen lokal bzw. im Portable-Datenpfad."
                                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />
                                    <TextBlock Text="Datenbank" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <TextBlock Text="Einstellungen" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <Button Content="Datenordner öffnen" HorizontalAlignment="Right"
                                            Command="{Binding OpenDataDirectoryCommand}" Style="{StaticResource ActionButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Daten &amp; Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,14,6,16">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Backup &amp; Wiederherstellung" Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Ein .kpibackup enthält einen konsistenten SQLite-Snapshot, Anwendungseinstellungen und Backup-Metadaten. Vor einer Wiederherstellung wird automatisch ein Sicherheitsbackup erstellt."
                                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Backup-Ordner" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0" />
                                    <TextBox Grid.Column="1" Text="{Binding DefaultBackupDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Backup-Ordner" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Auswählen" Margin="0,0,8,0"
                                            Command="{Binding BrowseBackupDirectoryCommand}" Style="{StaticResource ActionButtonStyle}" />
                                    <Button Grid.Column="3" Content="Öffnen" Command="{Binding OpenBackupDirectoryCommand}" Style="{StaticResource ActionButtonStyle}" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Automatik" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0" />
                                    <CheckBox Grid.Column="1" Content="Auto-Backup beim Beenden" IsChecked="{Binding AutoBackupOnExit}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Behalten:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding BackupRetentionCount, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="52" HorizontalAlignment="Left" AutomationProperties.Name="Anzahl aufzubewahrender Backups" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Text="Automatische Backups werden nach Anzahl begrenzt; manuelle Sicherheitsbackups bleiben erhalten."
                                               Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                </Grid>

                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Backup wiederherstellen" Command="{Binding RestoreBackupCommand}" Margin="0,0,8,8" Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="SolutionCompakt neu starten" Command="{Binding RestartApplicationCommand}" Margin="0,0,8,8" Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="Backup jetzt erstellen" Command="{Binding CreateBackupCommand}" Margin="0,0,0,8" Style="{StaticResource PrimaryActionButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Papierkorb">
                <Grid Margin="6,14,6,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Nachvollziehbarer Papierkorb" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="Gelöschte Datensätze werden nicht endgültig entfernt. Die Löschung bleibt mit Benutzer und Zeitpunkt erhalten; wiederhergestellte Einträge bleiben ebenfalls als Historie sichtbar."
                                       Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="RecycleBinGrid"
                                  ItemsSource="{Binding RecycleBinItems}"
                                  SelectedItem="{Binding SelectedRecycleBinItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gelöscht am" Binding="{Binding DeletedAtText}" Width="150" />
                                <DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="125" />
                                <DataGridTextColumn Header="Datensatz" Binding="{Binding DisplayName}" Width="2*" />
                                <DataGridTextColumn Header="Gelöscht von" Binding="{Binding DeletedBy}" Width="110" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="1.4*" />
                                <DataGridTextColumn Header="Grund" Binding="{Binding Reason}" Width="1.2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStateStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RecycleBinGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Der Papierkorb ist leer." Style="{StaticResource CardTitleTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Gelöschte Datensätze erscheinen hier mit Benutzer und Zeitpunkt." Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Aktualisieren" Command="{Binding RefreshRecycleBinCommand}" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="Ausgewählten Datensatz wiederherstellen" Command="{Binding RestoreRecycleBinItemCommand}"
                                IsEnabled="{Binding SelectedRecycleBinItem.CanRestore}" Style="{StaticResource PrimaryActionButtonStyle}" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Sicherheit">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,14,6,16">
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Recovery-Code" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Der Recovery-Code ist der Notfallzugang für ein vergessenes Passwort. Gespeichert werden nur Hash und Salt."
                                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,10" />
                                    <TextBlock Text="{Binding RecoveryCodeStatus}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Beim Erneuern wird der bisherige Code sofort ungültig."
                                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,20,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Recovery-Code erneuern" VerticalAlignment="Center"
                                        Command="{Binding ManageRecoveryCodeCommand}" Style="{StaticResource PrimaryActionButtonStyle}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Automatische Sitzungssperre" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Bei Inaktivität wird die Anwendung gesperrt. Entsperren kann nur derselbe Benutzer mit seinem Passwort; offene Eingaben bleiben erhalten."
                                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,24,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Aktiv" IsChecked="{Binding AutoLockEnabled}" Margin="0,0,14,0" />
                                    <TextBlock Text="Nach" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <ComboBox ItemsSource="{Binding AutoLockOptions}" SelectedItem="{Binding AutoLockMinutes}" Width="78" AutomationProperties.Name="Zeit bis zur automatischen Sitzungssperre" />
                                    <TextBlock Text="Min." VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,14,6,16">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="CSV-Export" Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Der Komplett-Export erstellt getrennte CSV-Dateien für Mitarbeiter, Skills, Arbeitsplätze, Schichten, Abwesenheiten, Planung, Produktionsaufträge, Ist-Produktion/OEE und Stillstände."
                                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Export-Ordner" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0" />
                                    <TextBox Grid.Column="1" Text="{Binding DefaultExportDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Export-Ordner" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Auswählen" Margin="0,0,8,0"
                                            Command="{Binding BrowseExportDirectoryCommand}" Style="{StaticResource ActionButtonStyle}" />
                                    <Button Grid.Column="3" Content="Öffnen" Command="{Binding OpenExportDirectoryCommand}" Style="{StaticResource ActionButtonStyle}" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CSV-Trennzeichen" Style="{StaticResource FieldLabelTextStyle}" VerticalAlignment="Center" Margin="0" />
                                    <TextBox Grid.Column="1" Text="{Binding CsvDelimiter, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="1" Width="48" HorizontalAlignment="Left" AutomationProperties.Name="CSV-Trennzeichen" />
                                    <CheckBox Grid.Column="2" Content="UTF-8 BOM für Excel" IsChecked="{Binding IncludeUtf8Bom}" />
                                    <TextBlock Grid.Column="3" Text="Semikolon ist für deutschsprachige Excel-Installationen meist am praktischsten."
                                               Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                </Grid>

                                <Button Content="Alle Daten als CSV exportieren" HorizontalAlignment="Right"
                                        Command="{Binding ExportAllCommand}" Style="{StaticResource PrimaryActionButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Benutzeroberfläche">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,14,6,16">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Persönliche Ansicht" Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Sidebar, aufgeklappte Menügruppen sowie Kalenderansicht und Filter werden pro angemeldetem Benutzer gespeichert. Änderungen anderer Benutzer beeinflussen deine Ansicht nicht."
                                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />
                                <Border Style="{StaticResource AlertCardStyle}"
                                        Background="{StaticResource InfoSoftBrush}"
                                        BorderBrush="{StaticResource InfoBorderBrush}"
                                        Margin="0,0,0,14">
                                    <TextBlock Text="Mit Zurücksetzen werden Navigation und Kalenderfilter auf die Standardansicht gestellt. Die vollständige Navigation wird beim nächsten Anmelden neu geladen."
                                               Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" />
                                </Border>
                                <CheckBox Content="Kurze Kontext-Hinweise unter dem Seitentitel anzeigen"
                                          IsChecked="{Binding ShowContextHints, Mode=TwoWay}"
                                          Margin="0,0,0,14" HorizontalAlignment="Left" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Persönliche Ansicht zurücksetzen"
                                            Command="{Binding ResetUiPreferencesCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="App-Einführung erneut starten"
                                            Command="{Binding StartGuidedTourCommand}"
                                            Style="{StaticResource PrimaryActionButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertCardStyle}">
                    <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers><DataTrigger Binding="{Binding StatusMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>