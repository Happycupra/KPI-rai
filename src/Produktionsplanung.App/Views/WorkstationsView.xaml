<UserControl x:Class="Produktionsplanung.App.Views.WorkstationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Arbeitsplätze / Produktionslinien" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Besetzung und Status der Arbeitsplätze verwalten." Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedWorkstation}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="*"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinimumStaff}" Width="70"/>
                    <DataGridTextColumn Header="Optimal" Binding="{Binding OptimalStaff}" Width="80"/>
                    <DataGridTextColumn Header="Max" Binding="{Binding MaximumStaff}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Arbeitsplatz bearbeiten" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Name"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                    <TextBlock Text="Bereich"/><TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                    <TextBlock Text="Mindestbesetzung"/><TextBox Text="{Binding MinimumStaff}" Margin="0,4,0,10"/>
                    <TextBlock Text="Optimale Besetzung"/><TextBox Text="{Binding OptimalStaff}" Margin="0,4,0,10"/>
                    <TextBlock Text="Maximale Besetzung"/><TextBox Text="{Binding MaximumStaff}" Margin="0,4,0,10"/>
                    <CheckBox Content="Arbeitsplatz aktiv" IsChecked="{Binding IsActive}" Margin="0,2,0,16"/>
                    <WrapPanel>
                        <Button Content="Neu" Command="{Binding NewWorkstationCommand}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Speichern" Command="{Binding SaveCommand}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Löschen" Command="{Binding DeleteCommand}" Padding="14,7"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
