<UserControl x:Class="Produktionsplanung.App.Views.WorkTimeCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Arbeitszeit / Betrieb" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding MonthText}" FontSize="15" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="‹" Width="38" Height="38" Command="{Binding PreviousMonthCommand}" Margin="0,0,6,0" Style="{StaticResource CompactButtonStyle}"/>
                <Button Content="Aktueller Monat" Command="{Binding CurrentMonthCommand}" Margin="0,0,6,0" Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="›" Width="38" Height="38" Command="{Binding NextMonthCommand}" Margin="0,0,12,0" Style="{StaticResource CompactButtonStyle}"/>
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}"/>
            </WrapPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Arbeitszeit / Betrieb">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="0.72*"/><RowDefinition Height="14"/><RowDefinition Height="1.28*"/></Grid.RowDefinitions>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Soll / Plan / Ist je Mitarbeiter" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Balances}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="2*"/>
                                    <DataGridTextColumn Header="Soll h" Binding="{Binding TargetHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Plan h" Binding="{Binding PlannedHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Ist h" Binding="{Binding ActualHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Saldo h" Binding="{Binding BalanceHours, StringFormat=+0.0;-0.0;0.0}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Betriebs- und Arbeitszeiteinträge" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="WorkTimeEntriesGrid" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="WorkTimeRow_PreviewMouseRightButtonDown"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Mitarbeiterkarte" Click="WorkTimeEmployeeCardContext_Click"/>
                                        <MenuItem Header="Skills / Stammdaten" Click="WorkTimeEmployeeMasterContext_Click"/>
                                        <MenuItem Header="Aktuell geplant" Click="WorkTimeEmployeePlanContext_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="90"/>
                                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Artikel" Binding="{Binding ArticleNumber}" Width="90"/>
                                    <DataGridTextColumn Header="Charge" Binding="{Binding BatchNumber}" Width="90"/>
                                    <DataGridTextColumn Header="Auftrag" Binding="{Binding OrderNumber}" Width="90"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="115"/>
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="105"/>
                                    <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" Width="95"/>
                                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="1.4*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Grid.RowSpan="3" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Betriebszeit erfassen" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Jeder neue Eintrag wird automatisch dem angemeldeten Mitarbeiter zugeordnet."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <TextBlock Text="Angemeldeter Mitarbeiter" FontWeight="SemiBold"/>
                                <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="7" Padding="10" Margin="0,4,0,12">
                                    <TextBlock Text="{Binding CurrentEmployeeName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </Border>

                                <TextBlock Text="Datum" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding EntryDate, Mode=TwoWay}" Height="38" Margin="0,4,0,12"/>

                                <TextBlock Text="Artikel" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" Height="38" Margin="0,4,0,12" IsTextSearchEnabled="True"/>

                                <TextBlock Text="Charge / Auftrag" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" Height="38" Margin="0,4,0,12" IsTextSearchEnabled="True"/>

                                <TextBlock Text="Status *" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}" Text="{Binding EntryStatus, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" IsTextSearchEnabled="True" Height="38" Margin="0,4,0,4"/>
                                <TextBlock Text="Pflichtfeld · frei eingeben. Neue Status werden gespeichert und später wieder angeboten."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Start (HH:mm)" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,4,0,12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ende (HH:mm)" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,4,0,12"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Pause-Abzug Minuten (optional)" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding BreakMinutes}" Height="38" Margin="0,4,0,12"/>

                                <TextBlock Text="Bemerkung" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding EntryComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,14" VerticalScrollBarVisibility="Auto"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="Jetzt starten" Command="{Binding StartNowCommand}" IsEnabled="{Binding CanLogTime}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                                    <Button Grid.Column="2" Content="Laufenden Eintrag stoppen" Command="{Binding StopRunningCommand}" IsEnabled="{Binding HasRunningEntry}" Style="{StaticResource ActionButtonStyle}"/>
                                </Grid>
                                <Button Content="Eintrag speichern / Änderungen übernehmen" Command="{Binding SaveEntryCommand}" IsEnabled="{Binding CanLogTime}" Margin="0,0,0,7" Style="{StaticResource PrimaryActionButtonStyle}"/>
                                <Button Content="Neu" Command="{Binding NewEntryCommand}" Margin="0,0,0,7" Style="{StaticResource ActionButtonStyle}"/>
                                <Button Content="In Papierkorb" Command="{Binding DeleteEntryCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Betriebskalender" IsEnabled="{Binding CanManageOperatingCalendar}">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Kalender-Ausnahmen" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Ohne Ausnahme gilt automatisch Montag bis Freitag als Arbeitstag. Hinterlege hier Feiertage, Betriebsferien, halbe Tage oder Sonderarbeitstage." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <DataGrid ItemsSource="{Binding CalendarDays}" SelectedItem="{Binding SelectedCalendarDay, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="120"/>
                                    <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Typ" Binding="{Binding WorkingDayText}" Width="90"/>
                                    <DataGridTextColumn Header="Soll-Faktor" Binding="{Binding FactorText}" Width="85"/>
                                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Kalendertag bearbeiten" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <TextBlock Text="Datum" FontWeight="SemiBold"/>
                            <DatePicker SelectedDate="{Binding CalendarDate, Mode=TwoWay}" Height="38" Margin="0,4,0,12"/>
                            <TextBlock Text="Bezeichnung" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CalendarName, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,4,0,12"/>
                            <CheckBox Content="Arbeitstag / Sonderarbeitstag" IsChecked="{Binding CalendarIsWorkingDay}" Margin="0,2,0,12"/>
                            <TextBlock Text="Sollstunden-Faktor" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CalendarTargetHoursFactor}" Height="38" Margin="0,4,0,5"/>
                            <TextBlock Text="0 = frei · 0.5 = halber Tag · 1 = normal · bis 2 möglich" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,12"/>
                            <TextBlock Text="Kommentar" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CalendarComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,14" VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Speichern" Command="{Binding SaveCalendarDayCommand}" Margin="0,0,0,7" Style="{StaticResource PrimaryActionButtonStyle}"/>
                            <Button Content="Neu" Command="{Binding NewCalendarDayCommand}" Margin="0,0,0,7" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Ausnahme archivieren" Command="{Binding DeleteCalendarDayCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
