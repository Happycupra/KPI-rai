<UserControl x:Class="Produktionsplanung.App.Views.AbsencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Abwesenheiten" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Ferien, Krankheit und weitere Abwesenheiten erfassen." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Absences}" SelectedItem="{Binding SelectedAbsence}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="2*"/>
                    <DataGridTextColumn Header="Art" Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="Von" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Bis" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Abwesenheit bearbeiten" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Mitarbeiter"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" Margin="0,4,0,10">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding LastName}"/><Run Text=", "/><Run Text="{Binding FirstName}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Art"/><ComboBox ItemsSource="{Binding AbsenceTypes}" SelectedItem="{Binding AbsenceType}" Margin="0,4,0,10"/>
                    <TextBlock Text="Startdatum"/><DatePicker SelectedDate="{Binding StartDate}" Margin="0,4,0,10"/>
                    <TextBlock Text="Enddatum"/><DatePicker SelectedDate="{Binding EndDate}" Margin="0,4,0,10"/>
                    <TextBlock Text="Kommentar"/><TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,16" VerticalScrollBarVisibility="Auto"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Neu" Command="{Binding NewAbsenceCommand}" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Speichern" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}"/>
                        <Button Content="Löschen" Command="{Binding DeleteCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
