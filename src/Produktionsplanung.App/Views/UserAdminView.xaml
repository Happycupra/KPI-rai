<UserControl x:Class="Produktionsplanung.App.Views.UserAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="310" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Benutzer &amp; Audit" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Lokale Benutzer, Rollen und die letzten 500 Audit-Einträge verwalten." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Aktualisieren" Height="34" Padding="14,0" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14">
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Benutzer" Binding="{Binding Username}" Width="*" />
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.2*" />
                        <DataGridTextColumn Header="Rolle" Binding="{Binding Role}" Width="105" />
                        <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="60" />
                        <DataGridTextColumn Header="Letzter Login" Binding="{Binding LastLoginText}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding EditorTitle}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,4">
                            <TextBlock Text="Benutzername" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,9" />

                            <TextBlock Text="Anzeigename" FontWeight="SemiBold" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,9" />

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rolle" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}"
                                              Height="32" Margin="0,4,8,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Aktiv" IsChecked="{Binding IsActive}"
                                          VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </Grid>

                            <TextBlock Text="Passwort" FontWeight="SemiBold" />
                            <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPasswordBox_PasswordChanged"
                                         Height="32" Margin="0,4,0,3" />
                            <TextBlock Text="Mindestens 10 Zeichen, 1 Grossbuchstabe, 1 Kleinbuchstabe und 1 Zahl. Bei bestehenden Benutzern leer lassen, wenn das Passwort unverändert bleiben soll."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Neuer Benutzer" Height="34" Padding="12,0"
                                    Command="{Binding NewUserCommand}" Margin="0,0,8,0" />
                            <Button Content="Speichern" Width="110" Height="34"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveUserCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14">
            <StackPanel>
                <TextBlock Text="Audit-Log" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding AuditRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zeit" Binding="{Binding TimestampText}" Width="145" />
                        <DataGridTextColumn Header="Benutzer" Binding="{Binding Username}" Width="110" />
                        <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="100" />
                        <DataGridTextColumn Header="Bereich" Binding="{Binding EntityType}" Width="130" />
                        <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="70" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
