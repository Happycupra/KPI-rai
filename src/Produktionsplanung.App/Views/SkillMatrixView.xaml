<UserControl x:Class="Produktionsplanung.App.Views.SkillMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource PageHeaderSpacing}">
            <TextBlock Text="Skill-Matrix" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Qualifikationen verwalten und Skill-Level pro Mitarbeiter pflegen: 0 = keine, 1 = in Ausbildung, 2 = qualifiziert, 3 = Experte/Trainer, 4 = Level 4, 5 = Admin"
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding NewQualificationName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Neue Qualifikation" />
                <Button Grid.Column="1"
                        Content="+ Qualifikation"
                        Command="{Binding AddQualificationCommand}"
                        Margin="8,0,0,0"
                        Style="{StaticResource ActionButtonStyle}" />

                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding Qualifications}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedQualification}" />
                <Button Grid.Column="4"
                        Content="Qualifikation löschen"
                        Command="{Binding DeleteQualificationCommand}"
                        Margin="8,0,0,0"
                        Style="{StaticResource DangerActionButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="12">
            <DataGrid x:Name="MatrixGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      FrozenColumnCount="3" />
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tipp: Level direkt in der Matrix auswählen und anschliessend speichern."
                       Style="{StaticResource SecondaryTextStyle}"
                       VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Neu laden"
                        Command="{Binding LoadCommand}"
                        Margin="0,0,8,0"
                        Style="{StaticResource ActionButtonStyle}" />
                <Button Content="Skill-Matrix speichern"
                        Command="{Binding SaveMatrixCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>