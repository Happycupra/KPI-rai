<UserControl x:Class="Produktionsplanung.App.Views.WeekPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <Style x:Key="WeekCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Wochenplanung" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="{Binding WeekRangeText}" FontSize="16" Foreground="#64748B" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="‹" Width="38" Height="34" Command="{Binding PreviousWeekCommand}" Margin="0,0,8,0" />
                <Button Content="Diese Woche" Height="34" Padding="14,0" Command="{Binding CurrentWeekCommand}" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding WeekStart, Mode=TwoWay}" Width="145" Height="34" Margin="0,0,8,0" />
                <Button Content="›" Width="38" Height="34" Command="{Binding NextWeekCommand}" Margin="0,0,8,0" />
                <Button Content="Aktualisieren" Height="34" Padding="14,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Wochenaktionen" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="Die Vorwoche kann nur in eine noch leere Zielwoche kopiert werden. Abwesende Mitarbeiter werden dabei übersprungen."
                                       Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Vorwoche kopieren" Padding="18,8" Margin="18,0,0,0"
                                VerticalAlignment="Center" Command="{Binding CopyPreviousWeekCommand}" />
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Mitarbeiterübersicht" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4" />
                        <TextBlock Text="Arbeitsplatz, Schicht und Zeit pro Mitarbeiter und Tag; Abwesenheiten werden direkt in der Zelle angezeigt."
                                   Foreground="#64748B" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding EmployeeRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" RowHeight="Auto" MinHeight="310"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="150" ElementStyle="{StaticResource WeekCellText}" />
                                <DataGridTextColumn Header="Funktion" Binding="{Binding Role}" Width="120" ElementStyle="{StaticResource WeekCellText}" />
                                <DataGridTextColumn Header="Montag" Binding="{Binding Monday}" Width="150" ElementStyle="{StaticResource WeekCellText}" />
                                <DataGridTextColumn Header="Dienstag" Binding="{Binding Tuesday}" Width="150" ElementStyle="{StaticResource WeekCellText}" />
                                <DataGridTextColumn Header="Mittwoch" Binding="{Binding Wednesday}" Width="150" ElementStyle="{StaticResource WeekCellText}" />
                                <DataGridTextColumn Header="Donnerstag" Binding="{Binding Thursday}" Width="150" ElementStyle="{StaticResource WeekCellText}" />
                                <DataGridTextColumn Header="Freitag" Binding="{Binding Friday}" Width="150" ElementStyle="{StaticResource WeekCellText}" />
                                <DataGridTextColumn Header="Samstag" Binding="{Binding Saturday}" Width="150" ElementStyle="{StaticResource WeekCellText}" />
                                <DataGridTextColumn Header="Sonntag" Binding="{Binding Sunday}" Width="150" ElementStyle="{StaticResource WeekCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Besetzung je Tag, Arbeitsplatz und Schicht" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding StaffingRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" MinHeight="240" MaxHeight="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tag" Binding="{Binding DayText}" Width="90" />
                                    <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.2*" />
                                    <DataGridTextColumn Header="Schicht" Binding="{Binding ShiftName}" Width="1.1*" />
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="95" />
                                    <DataGridTextColumn Header="Plan" Binding="{Binding PlannedStaff}" Width="55" />
                                    <DataGridTextColumn Header="Min" Binding="{Binding MinimumStaff}" Width="50" />
                                    <DataGridTextColumn Header="Opt" Binding="{Binding OptimalStaff}" Width="50" />
                                    <DataGridTextColumn Header="Max" Binding="{Binding MaximumStaff}" Width="50" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="105" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Warnungen und Hinweise" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="#B91C1C" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#334155" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
