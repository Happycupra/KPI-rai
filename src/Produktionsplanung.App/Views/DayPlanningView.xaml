<UserControl x:Class="Produktionsplanung.App.Views.DayPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Schichtansicht" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{Binding SelectedDateText}" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="‹" Width="38" Height="38" Command="{Binding PreviousDayCommand}" Margin="0,0,8,0" Style="{StaticResource CompactButtonStyle}" />
                <Button Content="Heute" Command="{Binding TodayCommand}" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" />
                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="145" Height="38" Margin="0,0,8,0" />
                <Button Content="›" Width="38" Height="38" Command="{Binding NextDayCommand}" Margin="0,0,8,0" Style="{StaticResource CompactButtonStyle}" />
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MasterDetailGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="410" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="PlanningOverviewPanel" Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                <StackPanel>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Schichtkonflikte und Hinweise" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Gelb">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Hinweis">
                                                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="KRITISCH" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Gelb">
                                                                    <Setter Property="Text" Value="WARNUNG" />
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Hinweis">
                                                                    <Setter Property="Text" Value="HINWEIS" />
                                                                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Produktion besetzen" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Mitarbeiter greifen und direkt auf die gewünschte Produktion ziehen."
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Auto besetzen" Command="{Binding AutoStaffSelectedOrderCommand}" VerticalAlignment="Center" Style="{StaticResource ActionButtonStyle}"/>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,10">
                                <ItemsControl ItemsSource="{Binding Employees}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PrimarySoftBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="14" Padding="7,4" Margin="0,0,6,2"
                                                    Cursor="Hand" ToolTip="{Binding DisplayName}"
                                                    PreviewMouseLeftButtonDown="EmployeeChip_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="EmployeeChip_PreviewMouseMove">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="9.5" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding ShortName}" Margin="6,0,2,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextBrush}" FontSize="11.5" FontWeight="SemiBold"
                                                               MaxWidth="82" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <DataGrid x:Name="ProductionCoverageGrid"
                                      ItemsSource="{Binding ProductionOrderCoverage}"
                                      SelectedItem="{Binding SelectedProductionOrderCoverage, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="145" MaxHeight="255"
                                      AllowDrop="True"
                                      PreviewDragOver="ProductionCoverageGrid_PreviewDragOver"
                                      Drop="ProductionCoverageGrid_Drop">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="Mitarbeiter hier ablegen · Rechtsklick für weitere Aktionen"/>
                                        <Setter Property="MinHeight" Value="32"/>
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="CoverageRow_PreviewMouseRightButtonDown"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Übersicht / Chargendetails" Click="CoverageDetailsContext_Click"/>
                                        <MenuItem Header="Auftrag bearbeiten" Click="CoverageEditContext_Click"/>
                                        <MenuItem Header="Ist-Produktion / OEE" Click="CoverageActualContext_Click"/>
                                        <MenuItem Header="Artikelverzeichnis" Click="CoverageArticlesContext_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Auftrag" Binding="{Binding OrderNumber}" Width="82" />
                                    <DataGridTextColumn Header="Produkt" Binding="{Binding Product}" Width="1.05*" />
                                    <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="0.95*" />
                                    <DataGridTextColumn Header="Schicht" Binding="{Binding ShiftName}" Width="92" />
                                    <DataGridTemplateColumn Header="Team" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TeamDisplay}" ToolTip="{Binding TeamNames}"
                                                           FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Soll" Binding="{Binding RequiredStaff}" Width="48" />
                                    <DataGridTextColumn Header="Ist" Binding="{Binding PlannedStaff}" Width="44" />
                                    <DataGridTextColumn Header="Diff." Binding="{Binding DifferenceText}" Width="50" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding CoverageStatus}" Width="92" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Besetzung je Arbeitsplatz und Schicht" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Bewertet werden tatsächlich geplante Arbeitsplatz-/Schicht-Kombinationen; die Auftragsabdeckung oben zeigt den konkreten Personalbedarf." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding Staffing}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" MinHeight="150" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Schicht" Binding="{Binding ShiftName}" Width="1.1*" />
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="95" />
                                    <DataGridTextColumn Header="Geplant" Binding="{Binding PlannedStaff}" Width="70" />
                                    <DataGridTextColumn Header="Min" Binding="{Binding MinimumStaff}" Width="60" />
                                    <DataGridTextColumn Header="Opt" Binding="{Binding OptimalStaff}" Width="60" />
                                    <DataGridTextColumn Header="Max" Binding="{Binding MaximumStaff}" Width="60" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="115" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Geplante Einsätze" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <Button Grid.Column="1" Content="+ Neue Zuweisung" Padding="14,6" Command="{Binding NewAssignmentCommand}" />
                            </Grid>
                            <DataGrid x:Name="AssignmentsGrid" ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="260">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="AssignmentRow_PreviewMouseRightButtonDown"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                    <MenuItem Header="Mitarbeiterkarte" Click="AssignmentEmployeeCardContext_Click"/>
                                    <MenuItem Header="Skills / Stammdaten" Click="AssignmentEmployeeMasterContext_Click"/>
                                    <MenuItem Header="Aktuell geplant" Click="AssignmentEmployeePlanContext_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Aus Planung entfernen…" Click="AssignmentRemoveContext_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="1.5*" />
                                    <DataGridTextColumn Header="Funktion" Binding="{Binding Role}" Width="1.2*" />
                                    <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.2*" />
                                    <DataGridTextColumn Header="Schicht" Binding="{Binding ShiftName}" Width="1.2*" />
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="100" />
                                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="1.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="AssignmentEditorPanel" Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Zuweisung" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Mitarbeiter einer Schicht und einem Arbeitsplatz zuordnen." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,20" />
                        <TextBlock Text="Mitarbeiter" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="38" Margin="0,0,0,14" />
                        <TextBlock Text="Arbeitsplatz" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedWorkstation, Mode=TwoWay}" DisplayMemberPath="Name" Height="38" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding WorkstationSkillRequirementText}" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <TextBlock Text="Schicht" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="38" Margin="0,0,0,14" />

                        <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Passende Mitarbeitende" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Verfügbar, nicht doppelt belegt und – falls gefordert – ausreichend qualifiziert. Sortiert nach Skill und Wochenbelastung."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <ItemsControl ItemsSource="{Binding EmployeeSuggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" CornerRadius="7" Padding="8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SkillText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                                        <TextBlock Text="{Binding LoadText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Übernehmen" Padding="10,4" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Kommentar" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18" />
                        <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                            <TextBlock Text="SolutionCompakt prüft Abwesenheit, Doppelbelegung, Betriebskalender und Qualifikationspflichten. Skill-Verstösse erscheinen zusätzlich im Warnungsbereich."
                                       TextWrapping="Wrap" Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Zuweisung gespeichert.">
                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Zuweisung gelöscht.">
                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="Planung aktualisiert.">
                                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="Zuweisung gespeichert."><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="Zuweisung gelöscht."><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="Planung aktualisiert."><Setter Property="Foreground" Value="{StaticResource InfoBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Button Content="Speichern" Command="{Binding SaveValidatedCommand}" Margin="0,0,0,8" Style="{StaticResource PrimaryActionButtonStyle}" />
                        <Button Content="Neue Zuweisung" Command="{Binding NewAssignmentCommand}" Margin="0,0,0,8" Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="Ausgewählte Zuweisung entfernen…" Click="DeleteAssignment_Click" Style="{StaticResource DangerActionButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
