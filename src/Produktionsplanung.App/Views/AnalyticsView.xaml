<UserControl x:Class="Produktionsplanung.App.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Auswertungen / KPIs" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="{Binding PeriodText}" FontSize="16" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding PeriodModes}" SelectedItem="{Binding SelectedPeriodMode, Mode=TwoWay}"
                              Width="105" Height="34" Margin="0,0,8,0" />
                    <Button Content="‹" Width="38" Height="34" Command="{Binding PreviousPeriodCommand}" Margin="0,0,8,0" />
                    <Button Content="Aktuell" Height="34" Padding="14,0" Command="{Binding CurrentPeriodCommand}" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding AnchorDate, Mode=TwoWay}" Width="145" Height="34" Margin="0,0,8,0" />
                    <Button Content="›" Width="38" Height="34" Command="{Binding NextPeriodCommand}" Margin="0,0,8,0" />
                    <Button Content="Aktualisieren" Height="34" Padding="14,0" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Geplante Stunden" Foreground="#64748B" />
                        <TextBlock Text="{Binding PlannedHoursText}" FontSize="27" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="{Binding TargetHoursText, StringFormat=Soll: {0}}" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Stundendifferenz" Foreground="#64748B" />
                        <TextBlock Text="{Binding HoursDifferenceText}" FontSize="27" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Plan minus Soll" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Personalabdeckung" Foreground="#64748B" />
                        <TextBlock Text="{Binding PersonnelCoverageText}" FontSize="27" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="{Binding UnderstaffedOrders, StringFormat=Unterbesetzte Aufträge: {0}}" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Fehlzeitenquote" Foreground="#64748B" />
                        <TextBlock Text="{Binding AbsenceRateText}" FontSize="27" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="{Binding AbsenceDays, StringFormat=Abwesenheitstage: {0}}" Foreground="#64748B" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Aktive Mitarbeiter" Foreground="#64748B" />
                        <TextBlock Text="{Binding ActiveEmployees}" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{Binding PlannedEmployeeCount, StringFormat=Mit Planung: {0}}" Foreground="#64748B" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Aufträge gesamt" Foreground="#64748B" />
                        <TextBlock Text="{Binding TotalOrders}" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{Binding OpenOrders, StringFormat=Offen: {0}}" Foreground="#64748B" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Abschlussquote" Foreground="#64748B" />
                        <TextBlock Text="{Binding CompletionRateText}" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{Binding CompletedOrders, StringFormat=Abgeschlossen: {0}}" Foreground="#64748B" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Auftragsprobleme" Foreground="#64748B" />
                        <TextBlock Text="{Binding ProblemOrders}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="{Binding RunningOrders, StringFormat=Laufend: {0}}" Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Verlauf im Zeitraum" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="Geplante Stunden je Tag; der Balken ist relativ zum stärksten Tag im gewählten Zeitraum." Foreground="#64748B" Margin="0,4,0,12" />
                        <ItemsControl ItemsSource="{Binding DailyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DayText}" VerticalAlignment="Center" Foreground="#334155" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding HoursChartPercent}"
                                                     Height="16" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding PlannedHoursText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding CoverageText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Auftragsstatus" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding OrderStatusRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#64748B" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mitarbeiterstunden" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Text="Sollstunden werden aus den hinterlegten Wochen-Sollstunden auf eine Mo–Fr-Basis umgerechnet." Foreground="#64748B" Margin="0,4,0,10" />
                    <DataGrid ItemsSource="{Binding EmployeeRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" MinHeight="220" MaxHeight="340">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="1.5*" />
                            <DataGridTextColumn Header="Funktion" Binding="{Binding Role}" Width="1.2*" />
                            <DataGridTextColumn Header="Soll" Binding="{Binding TargetHoursText}" Width="85" />
                            <DataGridTextColumn Header="Geplant" Binding="{Binding PlannedHoursText}" Width="85" />
                            <DataGridTextColumn Header="Differenz" Binding="{Binding DifferenceText}" Width="90" />
                            <DataGridTextColumn Header="Abwesenheitstage" Binding="{Binding AbsenceDays}" Width="115" />
                            <DataGridTemplateColumn Header="Planabdeckung" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding HoursCoveragePercent}" Height="14" Margin="4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Auswertung nach Arbeitsplatz / Linie" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding WorkstationRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" MinHeight="200" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.4*" />
                            <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="1.1*" />
                            <DataGridTextColumn Header="Aufträge" Binding="{Binding Orders}" Width="70" />
                            <DataGridTextColumn Header="Abgeschlossen" Binding="{Binding CompletedOrders}" Width="95" />
                            <DataGridTextColumn Header="Personalbedarf" Binding="{Binding RequiredStaff}" Width="95" />
                            <DataGridTextColumn Header="Gedeckt" Binding="{Binding CoveredStaff}" Width="70" />
                            <DataGridTextColumn Header="Abdeckung" Binding="{Binding CoverageText}" Width="85" />
                            <DataGridTextColumn Header="Planstunden" Binding="{Binding PlannedHoursText}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="OEE / Ist-Produktion" FontSize="21" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding OeeDataState}" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding OeeRecords, StringFormat=Ist-Erfassungen: {0}}" Foreground="#64748B" VerticalAlignment="Center" />
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="Verfügbarkeit" Foreground="#64748B"/><TextBlock Text="{Binding OeeAvailabilityText}" FontSize="24" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="Leistung" Foreground="#64748B"/><TextBlock Text="{Binding OeePerformanceText}" FontSize="24" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="Qualität" Foreground="#64748B"/><TextBlock Text="{Binding OeeQualityText}" FontSize="24" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="10" Padding="14">
                            <StackPanel><TextBlock Text="OEE" Foreground="#047857"/><TextBlock Text="{Binding OeeText}" FontSize="26" FontWeight="Bold" Foreground="#047857"/></StackPanel>
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="Gesamtmenge" Foreground="#64748B"/><TextBlock Text="{Binding OeeTotalQuantityText}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="Gutmenge" Foreground="#64748B"/><TextBlock Text="{Binding OeeGoodQuantity, StringFormat={}{0:N0}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="Ausschuss" Foreground="#64748B"/><TextBlock Text="{Binding OeeScrapQuantityText}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12">
                            <StackPanel><TextBlock Text="Erfasster Stillstand" Foreground="#64748B"/><TextBlock Text="{Binding OeeDowntimeText}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid ItemsSource="{Binding OeeWorkstationRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" MinHeight="160" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Linie / Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.5*" />
                            <DataGridTextColumn Header="Erfassungen" Binding="{Binding Records}" Width="80" />
                            <DataGridTextColumn Header="Menge" Binding="{Binding TotalQuantity, StringFormat={}{0:N0}}" Width="85" />
                            <DataGridTextColumn Header="Ausschuss" Binding="{Binding ScrapQuantity, StringFormat={}{0:N0}}" Width="85" />
                            <DataGridTextColumn Header="Stillstand" Binding="{Binding DowntimeMinutes, StringFormat={}{0:N0} min}" Width="90" />
                            <DataGridTextColumn Header="Verfügbarkeit" Binding="{Binding AvailabilityText}" Width="95" />
                            <DataGridTextColumn Header="Leistung" Binding="{Binding PerformanceText}" Width="85" />
                            <DataGridTextColumn Header="Qualität" Binding="{Binding QualityText}" Width="85" />
                            <DataGridTextColumn Header="OEE" Binding="{Binding OeeText}" Width="85" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="#EFF6FF" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="OEE-Berechnung" FontWeight="SemiBold" Foreground="#1E3A8A" />
                    <TextBlock Text="Verfügbarkeit = Laufzeit / geplante Produktionszeit · Leistung = Ist-Menge / theoretische Menge bei Sollrate · Qualität = Gutmenge / Gesamtmenge · OEE = Verfügbarkeit × Leistung × Qualität. Leistung wird für OEE auf maximal 100 % begrenzt; Werte über der hinterlegten Sollrate sollten als Stammdatenhinweis geprüft werden."
                               TextWrapping="Wrap" Foreground="#1E3A8A" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" Margin="0,10,0,0" HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
