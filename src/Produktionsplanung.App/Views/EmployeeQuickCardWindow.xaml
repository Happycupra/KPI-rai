<Window x:Class="Produktionsplanung.App.Views.EmployeeQuickCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mitarbeiter" Width="440" MinWidth="420" Height="760" MinHeight="620"
        WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SubtleSurfaceBrush}" ShowInTaskbar="False"
        Icon="{StaticResource SolutionCompaktIcon}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="24" Background="#0F172A" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding FullName}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Role}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0">
                        <Run Text="{Binding Department}"/><Run Text=" · Pers.-Nr. "/><Run Text="{Binding PersonnelNumber}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="32" Height="32" Click="Close_Click"
                        Background="Transparent" BorderThickness="0" FontSize="15"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding ContextDateText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Wochenübersicht" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding WeekText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8"/>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="12" Margin="0,0,6,6">
                        <StackPanel><TextBlock Text="Soll" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding TargetHoursText}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="12" Margin="6,0,0,6">
                        <StackPanel><TextBlock Text="Geplant" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding PlannedHoursText}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="12" Margin="0,6,6,0">
                        <StackPanel><TextBlock Text="Ist" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding ActualHoursText}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="12" Margin="6,6,0,0">
                        <StackPanel><TextBlock Text="Saldo" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding BalanceHoursText}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Beschäftigung" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}">
                            <Run Text="Pensum: "/><Run Text="{Binding WorkloadPercent}"/><Run Text=" % · Vertrag: "/><Run Text="{Binding WeeklyTargetHours, StringFormat={}{0:0.##}}"/><Run Text=" h/Woche"/>
                        </TextBlock>
                        <TextBlock Text="Nächste Abwesenheit" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding NextAbsenceText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Qualifikationen" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Skills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                                        <Border Grid.Column="1" Background="{StaticResource InfoSoftBrush}" CornerRadius="7" Padding="8,2">
                                            <TextBlock Text="{Binding LevelText}" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Keine Qualifikationen hinterlegt." Foreground="#94A3B8" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Skills.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Einsätze in dieser Woche" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Assignments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Workstation}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Shift}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Keine Einsätze in dieser Woche." Foreground="#94A3B8" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Assignments.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Aktualisieren" Padding="12,7" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button Content="Tagesplan öffnen" Padding="14,7" Margin="0,0,8,0" Click="OpenDayPlan_Click"/>
                <Button Content="Stammdaten öffnen" Padding="14,7" Click="OpenEmployee_Click"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
