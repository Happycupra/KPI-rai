<Window x:Class="Produktionsplanung.App.PasswordRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolutionCompakt – Passwort wiederherstellen"
        Icon="{StaticResource SolutionCompaktIcon}"
        Width="500" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SubtleSurfaceBrush}">
    <Grid Margin="34">
        <StackPanel VerticalAlignment="Center">
            <Border Width="62" Height="62" CornerRadius="16" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource PrimaryDarkBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Passwort wiederherstellen" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Gib deinen Benutzernamen, den bei der Einrichtung gespeicherten Recovery-Code und ein neues Passwort ein."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,22" />

            <TextBlock Text="Benutzername" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox x:Name="UsernameBox" Height="38" Margin="0,0,0,14" />

            <TextBlock Text="Recovery-Code" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBox x:Name="RecoveryCodeBox" Height="38" Margin="0,0,0,14" CharacterCasing="Upper" />

            <TextBlock Text="Neues Passwort" FontWeight="SemiBold" Margin="0,0,0,5" />
            <PasswordBox x:Name="NewPasswordBox" Height="38" Margin="0,0,0,14" />

            <TextBlock Text="Passwort bestätigen" FontWeight="SemiBold" Margin="0,0,0,5" />
            <PasswordBox x:Name="ConfirmPasswordBox" Height="38" Margin="0,0,0,6" />
            <TextBlock Text="Mindestens 10 Zeichen, Gross-/Kleinbuchstaben und eine Zahl." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12" />

            <TextBlock x:Name="StatusBlock" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="30" Margin="0,0,0,10" />
            <Button Content="Passwort zurücksetzen" Height="38" Click="Reset_Click" IsDefault="True" Style="{StaticResource PrimaryActionButtonStyle}" />
            <Button Content="Zurück zur Anmeldung" Margin="0,8,0,0" Click="Cancel_Click" IsCancel="True" Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
