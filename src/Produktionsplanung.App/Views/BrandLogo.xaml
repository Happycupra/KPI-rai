<UserControl x:Class="Produktionsplanung.App.Views.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="218" Height="58">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="46" Height="46"
                CornerRadius="{StaticResource CardCornerRadius}"
                Background="{StaticResource SubtleSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">
            <Image Source="{StaticResource SolutionCompaktIcon}"
                   Width="34" Height="34" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   SnapsToDevicePixels="True" />
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Solution" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Compakt" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
            </StackPanel>
            <TextBlock Text="Production &amp; Workforce" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="1,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
