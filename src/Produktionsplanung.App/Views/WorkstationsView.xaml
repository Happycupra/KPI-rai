<UserControl x:Class="Produktionsplanung.App.Views.WorkstationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Arbeitsplätze / Produktionslinien" FontSize="27" FontWeight="SemiBold" Foreground="#102A43"/>
            <TextBlock Text="Maschinen, Besetzung, Qualifikationen und individuelle Schichtmodelle verwalten." Foreground="#627D98" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="610"/></Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#DCE6F0" BorderThickness="1" CornerRadius="11" Padding="14">
                <DataGrid ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedWorkstation}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.35*"/>
                        <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="*"/>
                        <DataGridTextColumn Header="Schichtbetrieb" Binding="{Binding ShiftModelSummary}" Width="1.25*"/>
                        <DataGridTextColumn Header="Pflicht-Skill" Binding="{Binding RequiredQualification.Name, TargetNullValue=–}" Width="1.2*"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinimumStaff}" Width="48"/>
                        <DataGridTextColumn Header="Opt" Binding="{Binding OptimalStaff}" Width="48"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaximumStaff}" Width="48"/>
                        <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="52"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DCE6F0" BorderThickness="1" CornerRadius="11" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Arbeitsplatz bearbeiten" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Name" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bereich / Ort" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="34"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Mindestbesetzung"/><TextBox Text="{Binding MinimumStaff}" Margin="0,4,0,0" Height="34"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Optimal"/><TextBox Text="{Binding OptimalStaff}" Margin="0,4,0,0" Height="34"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Maximum"/><TextBox Text="{Binding MaximumStaff}" Margin="0,4,0,0" Height="34"/></StackPanel>
                        </Grid>

                        <Border Background="#F6FAFF" BorderBrush="#CFE0F1" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Schichtbetrieb dieser Maschine" FontSize="16" FontWeight="SemiBold" Foreground="#173A5E"/>
                                        <TextBlock Text="Nur freigegebene Schichten werden bei neuen Produktionsläufen verwendet. Wochentage können je Schicht unterschiedlich sein."
                                                   Foreground="#5A6B7D" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="12" Padding="10,4" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ShiftModelText}" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,12,0,10">
                                    <TextBlock Text="Schnellwahl:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                                    <Button Content="1-Schicht" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="1" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="2-Schicht" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="2" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="3-Schicht" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="3" Padding="10,4" Margin="0,0,12,0"/>
                                    <Button Content="Mo–Fr" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="MoFr" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="7 Tage" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="7Tage" Padding="10,4"/>
                                </WrapPanel>

                                <Border Background="#EAF0F6" CornerRadius="6" Padding="7,5" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/><ColumnDefinition Width="150"/><ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="AN" FontSize="9" FontWeight="SemiBold" Foreground="#627D98" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="SCHICHT" FontSize="9" FontWeight="SemiBold" Foreground="#627D98"/>
                                        <TextBlock Grid.Column="2" Text="ZEIT" FontSize="9" FontWeight="SemiBold" Foreground="#627D98"/>
                                        <TextBlock Grid.Column="3" Text="MO" FontSize="9" FontWeight="SemiBold" Foreground="#627D98" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="DI" FontSize="9" FontWeight="SemiBold" Foreground="#627D98" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="MI" FontSize="9" FontWeight="SemiBold" Foreground="#627D98" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="DO" FontSize="9" FontWeight="SemiBold" Foreground="#627D98" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="FR" FontSize="9" FontWeight="SemiBold" Foreground="#627D98" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="SA" FontSize="9" FontWeight="SemiBold" Foreground="#627D98" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="SO" FontSize="9" FontWeight="SemiBold" Foreground="#627D98" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding ShiftRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#E1EAF3" BorderThickness="0,0,0,1" Padding="7,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38"/><ColumnDefinition Width="150"/><ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ShiftName}" FontWeight="SemiBold" Foreground="#243B53" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10" Foreground="#627D98" VerticalAlignment="Center"/>
                                                    <CheckBox Grid.Column="3" IsChecked="{Binding Monday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="4" IsChecked="{Binding Tuesday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="5" IsChecked="{Binding Wednesday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="6" IsChecked="{Binding Thursday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="7" IsChecked="{Binding Friday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="8" IsChecked="{Binding Saturday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="9" IsChecked="{Binding Sunday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Bestehende Produktionsschichten werden beim Ändern dieses Modells nicht automatisch verschoben. SolutionCompakt warnt stattdessen beim Speichern."
                                           Foreground="#8A5A12" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Qualifikationspflicht" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                                <TextBlock Text="Nur entsprechend qualifizierte Mitarbeitende werden vorgeschlagen; Fehlplanungen erscheinen als Skill-Warnung."
                                           Foreground="#1E3A8A" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Pflichtqualifikation"/>
                                <ComboBox ItemsSource="{Binding Qualifications}" SelectedItem="{Binding SelectedRequiredQualification, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mindest-Skill-Level"/>
                                <ComboBox ItemsSource="{Binding SkillLevels}" SelectedItem="{Binding SelectedRequiredQualificationLevel, Mode=TwoWay}" DisplayMemberPath="Name" Height="34" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Arbeitsplatz aktiv" IsChecked="{Binding IsActive}" Margin="0,2,0,14"/>
                        <WrapPanel>
                            <Button Content="Neu" Command="{Binding NewWorkstationCommand}" Padding="14,7" Margin="0,0,8,0"/>
                            <Button Content="Speichern" Command="{Binding SaveCommand}" Padding="16,7" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Löschen" Command="{Binding DeleteCommand}" Padding="14,7"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
