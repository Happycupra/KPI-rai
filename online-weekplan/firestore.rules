rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == "Administrator";
    }

    match /weekPlans/{weekId} {
      allow read: if signedIn();
      allow write: if false;

      match /entries/{entryId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /productionSlots/{slotId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Admin changes stay separate from the published desktop snapshot.
      // This keeps SolutionCompakt as the source of truth.
      match /overrides/{entryId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    // Password hashes are server-side only. No browser client may read them.
    match /authUsers/{userId} {
      allow read, write: if false;
    }
  }
}
