<UserControl x:Class="Produktionsplanung.App.Views.ProductionActualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <Grid Margin="{StaticResource PageHeaderSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ist-Produktion / OEE" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Ist-Mengen, Laufzeiten, Ausschuss und Stillstände erfassen und OEE direkt berechnen."
                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="+ Neue Erfassung" Command="{Binding NewActualCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}" />
                </WrapPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Verfügbarkeit" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding AvailabilityText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Laufzeit / geplante Produktionszeit" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Leistung" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding PerformanceText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Ist-Menge gegen Sollrate" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Qualität" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding QualityText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Gutmenge / Gesamtmenge" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}">
                    <StackPanel>
                        <TextBlock Text="OEE" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OeeText}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Verfügbarkeit × Leistung × Qualität" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Erfasste Ist-Produktion" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Artikel, Charge, Auftrag, Produkt oder Arbeitsplatz suchen" AutomationProperties.Name="Ist-Produktion durchsuchen" />
                        </Grid>
                        <DataGrid x:Name="ActualsGrid" ItemsSource="{Binding ActualsView}" SelectedItem="{Binding SelectedActual, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" MinHeight="420" MaxHeight="560">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ActualRow_PreviewMouseRightButtonDown"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                <MenuItem Header="Chargendetails / Übersicht" Click="ActualBatchContext_Click"/>
                                <MenuItem Header="Auftrag bearbeiten" Click="ActualOrderContext_Click"/>
                                <MenuItem Header="Auftragscockpit" Click="ActualControlContext_Click"/>
                                <MenuItem Header="Artikelverzeichnis" Click="ActualArticlesContext_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90" />
                                <DataGridTextColumn Header="Auftrag" Binding="{Binding OrderNumber}" Width="90" />
                                <DataGridTextColumn Header="Artikel" Binding="{Binding ArticleNumber}" Width="110" />
                                <DataGridTextColumn Header="Produkt" Binding="{Binding Product}" Width="1.2*" />
                                <DataGridTextColumn Header="Charge" Binding="{Binding BatchNumber}" Width="110" />
                                <DataGridTextColumn Header="Linie" Binding="{Binding WorkstationName}" Width="1*" />
                                <DataGridTextColumn Header="Schicht" Binding="{Binding ShiftName}" Width="1*" />
                                <DataGridTextColumn Header="Menge" Binding="{Binding QuantityText}" Width="90" />
                                <DataGridTextColumn Header="Ausschuss" Binding="{Binding ScrapText}" Width="85" />
                                <DataGridTextColumn Header="Stillstand" Binding="{Binding DowntimeText}" Width="85" />
                                <DataGridTextColumn Header="OEE" Binding="{Binding OeeText}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ist-Erfassung" Style="{StaticResource DialogTitleTextStyle}" />
                        <TextBlock Text="Artikel und Charge werden aus dem Auftrag übernommen. Historische Angaben bleiben erhalten." Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,16" />

                        <TextBlock Text="Produktionsauftrag" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Artikelnummer" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding ArticleNumber}" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Charge / Los" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding BatchNumber}" IsReadOnly="True" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Datum" Style="{StaticResource FieldLabelTextStyle}" />
                                <DatePicker SelectedDate="{Binding ActualDate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sollrate / Stunde" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding IdealRatePerHour, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Geplante Produktionszeit (min)" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding PlannedProductionMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Laufzeit (min)" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding RunMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Gesamtmenge" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding TotalQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gutmenge" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding GoodQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ausschuss" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox Text="{Binding ScrapQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource FilterBarStyle}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding TheoreticalQuantityText, StringFormat=Theoretische Menge bei Sollrate: {0}}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="Gesamtmenge muss Gutmenge + Ausschuss entsprechen." Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Kommentar" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="36" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Ist-Erfassung speichern" Command="{Binding SaveCommand}" Margin="0,0,0,8" Style="{StaticResource PrimaryActionButtonStyle}" />
                        <Button Content="Ausgewählte Erfassung in Papierkorb" Command="{Binding DeleteActualCommand}" Style="{StaticResource DangerActionButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Stillstandsgründe" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Stillstände werden der ausgewählten, bereits gespeicherten Ist-Erfassung zugeordnet."
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,10" />
                        <DataGrid ItemsSource="{Binding Downtimes}" SelectedItem="{Binding SelectedDowntime, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="190" MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Grund" Binding="{Binding Reason}" Width="1.1*" />
                                <DataGridTextColumn Header="Dauer" Binding="{Binding MinutesText}" Width="90" />
                                <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Ausgewählten Stillstand in Papierkorb" Command="{Binding DeleteDowntimeCommand}"
                                HorizontalAlignment="Right" Margin="0,10,0,0" Style="{StaticResource DangerActionButtonStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stillstand hinzufügen" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="Grund" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding DowntimeReasons}" SelectedItem="{Binding DowntimeReason, Mode=TwoWay}" Margin="0,0,0,12" />
                        <TextBlock Text="Dauer (min)" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding DowntimeMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                        <TextBlock Text="Kommentar" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding DowntimeComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto"/>
                        <Button Content="Stillstand erfassen" Command="{Binding AddDowntimeCommand}" Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>