<Window x:Class="Produktionsplanung.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Produktionsplanung.App.Views"
        Title="SolutionCompakt Registrierung" Icon="{StaticResource SolutionCompaktIcon}"
        Width="560" Height="610" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource SubtleSurfaceBrush}">
    <Grid Margin="34">
        <StackPanel VerticalAlignment="Center">
            <views:BrandLogo HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <TextBlock Text="Testphase beendet" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Nach 7 Testtagen muss SolutionCompakt online registriert und vom Anbieter freigeschaltet werden. Danach wird die Freigabe bei jedem Programmstart online geprüft."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,18">
                <TextBlock x:Name="CurrentStatusBlock" TextWrapping="Wrap" Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Border>

            <TextBlock Text="Firma" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CompanyNameBox" Height="38" Margin="0,0,0,14"/>

            <TextBlock Text="Kontakt-E-Mail" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox" Height="38" Margin="0,0,0,6"/>
            <TextBlock Text="Diese Adresse wird der Registrierungsanfrage zugeordnet."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,16"/>

            <TextBlock x:Name="StatusBlock" TextWrapping="Wrap" MinHeight="44"
                       Foreground="{StaticResource WarningBrush}" Margin="0,0,0,12"/>

            <Button x:Name="RequestButton" Content="Registrierung anfragen" Height="40"
                    Click="Request_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
            <Button x:Name="CheckButton" Content="Freischaltung jetzt prüfen" Height="40" Margin="0,8,0,0"
                    Click="Check_Click" Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="SolutionCompakt beenden" Height="38" Margin="0,8,0,0"
                    Click="Close_Click" Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
