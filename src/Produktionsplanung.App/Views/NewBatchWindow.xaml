<Window x:Class="Produktionsplanung.App.Views.NewBatchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Neue Charge" Width="580" Height="780" MinHeight="450" MinWidth="440" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,10"/><WrapPanel HorizontalAlignment="Right"><Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0"/><Button Content="Charge erstellen" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Neue Charge" Style="{StaticResource PageTitleTextStyle}"/>
   <TextBlock Text="Jede Charge erhält einen eigenen Produktionsauftrag." Margin="0,4,0,16"/>
   <TextBlock Text="Artikel"/><ComboBox x:Name="Article" SelectionChanged="Article_Changed" Margin="0,4,0,10"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding ArticleNumber}"/><Run Text=" – "/><Run Text="{Binding Name}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <TextBlock Text="Auftragsnummer"/><TextBox Text="{Binding OrderNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
   <TextBlock Text="Chargennummer"/><TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
   <TextBlock Text="Menge"/><TextBox x:Name="QuantityInput" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,4,0,10"/>
   <TextBlock Text="{Binding Unit, StringFormat=Einheit: {0}}" Margin="0,0,0,10"/>
   <TextBlock Text="Planungsdatum"/><DatePicker x:Name="PlanDate" SelectedDate="{Binding PlannedDate}" Margin="0,4,0,10"/>
   <TextBlock Text="Arbeitsplatz"/><ComboBox ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedWorkstation}" DisplayMemberPath="Name" Margin="0,4,0,10"/>
   <TextBlock Text="Startschicht"/><ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" DisplayMemberPath="Name" Margin="0,4,0,10"/>
   <TextBlock Text="Anzahl Schichten"/><TextBox x:Name="ShiftCountInput" Text="{Binding PlannedShiftCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,4,0,10"/>
   <TextBlock Text="Personalbedarf"/><TextBox x:Name="StaffInput" Text="{Binding RequiredStaff, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,4,0,10"/>
   <TextBlock Text="Arbeitsplan"/><ComboBox x:Name="Routing" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10"/>
   <TextBlock Text="Produktionsschichten" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding RunSchedulePreview}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding DateText}"/><Run Text=" · "/><Run Text="{Binding ShiftName}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
