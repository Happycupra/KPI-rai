<UserControl x:Class="Produktionsplanung.App.Views.WhatIfPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource PageHeaderSpacing}">
            <TextBlock Text="What-if-Planung" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Personalengpässe simulieren und geprüfte Vorschläge einzeln in die Planung übernehmen."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Datum" Style="{StaticResource FieldLabelTextStyle}" />
                    <DatePicker SelectedDate="{Binding SelectedDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Arbeitsplatz" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding Workstations}"
                              SelectedItem="{Binding SelectedWorkstation}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Schicht" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding Shifts}"
                              SelectedItem="{Binding SelectedShift}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <Button Grid.Column="6"
                        Content="Simulation starten"
                        Command="{Binding SimulateCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSimulation}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Simulationsergebnis" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiCardStyle}" Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="IST" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="{Binding PlannedStaff}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                                    <TextBlock Text="eingeplante Mitarbeitende" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="ZIEL" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="{Binding TargetStaff}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="benötigte Mitarbeitende" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="FEHLEN" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="{Binding MissingStaff}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="offene Positionen" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource AlertCardStyle}" Background="{StaticResource SubtleSurfaceBrush}" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyTextStyle}" />
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Geprüfte Vorschläge" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Grid.Column="1" Text="Übernahme prüft alle Regeln erneut" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Alternatives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AlertCardStyle}" Background="{StaticResource CardBrush}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Rank}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="4,0,18,0">
                                                <TextBlock Text="{Binding EmployeeName}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Impact}" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="In Planung übernehmen"
                                                    Command="{Binding DataContext.ApplyAlternativeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStateStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Alternatives.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Keine übernehmbaren Alternativen vorhanden. Das Ziel ist erfüllt oder es wurden keine konfliktfreien, qualifizierten Mitarbeitenden gefunden."
                                       Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
