<Window x:Class="Produktionsplanung.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Produktionsplanung.App.Views"
        Title="SolutionCompakt Anmeldung" Icon="{StaticResource SolutionCompaktIcon}" Width="520" Height="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource SubtleSurfaceBrush}">
    <Grid Margin="34">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center">
                <views:BrandLogo HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <TextBlock x:Name="ModeTitle" Text="Anmeldung" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,4" />
                <TextBlock x:Name="ModeDescription" Text="Mit deinem lokalen Benutzerkonto anmelden." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,22" />

                <StackPanel x:Name="QuickAccessPanel" Visibility="Collapsed">
                    <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Eingeloggt bleiben ist aktiv" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock x:Name="QuickAccessUserBlock" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="4-stelliger Zugangs-PIN" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <PasswordBox x:Name="QuickPinBox" Height="42" MaxLength="4" Margin="0,0,0,8" />
                    <TextBlock Text="Der PIN gilt nur auf diesem Gerät. Das Passwort wird nicht gespeichert."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Content="Mit Passwort / anderem Konto anmelden" Click="SwitchToPassword_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryDarkBrush}"
                            FontWeight="SemiBold" HorizontalAlignment="Left" Padding="0,4" Margin="0,0,0,12" Cursor="Hand" />
                </StackPanel>

                <StackPanel x:Name="StandardLoginPanel">
                    <StackPanel x:Name="CompanyPanel" Visibility="Collapsed">
                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                            <TextBlock Text="Diese Installation wird genau einer Firma zugeordnet. Der Firmen-Code wird später auch für den Online-Login verwendet."
                                       Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="Firmenname" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox x:Name="CompanyNameBox" Height="38" Margin="0,0,0,14" TextChanged="CompanyNameBox_TextChanged" />
                        <TextBlock Text="Firmen-Code" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox x:Name="CompanyCodeBox" Height="38" Margin="0,0,0,5" TextChanged="CompanyCodeBox_TextChanged" />
                        <TextBlock Text="3–24 Zeichen · Buchstaben, Zahlen und Bindestriche. Beispiel: MUSTER-AG"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,14" />
                    </StackPanel>

                    <StackPanel x:Name="DisplayNamePanel" Visibility="Collapsed">
                        <TextBlock Text="Anzeigename" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox x:Name="DisplayNameBox" Height="38" Margin="0,0,0,14" />
                    </StackPanel>

                    <TextBlock Text="Benutzername" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="UsernameBox" Height="38" Margin="0,0,0,14" />

                    <TextBlock Text="Passwort" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <PasswordBox x:Name="PasswordBox" Height="38" Margin="0,0,0,10" />

                    <Button x:Name="ForgotPasswordButton" Content="Passwort vergessen?" Click="ForgotPassword_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold"
                            HorizontalAlignment="Right" Padding="6,3" Margin="0,0,0,10" Cursor="Hand" />

                    <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed">
                        <TextBlock Text="Passwort bestätigen" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <PasswordBox x:Name="ConfirmPasswordBox" Height="38" Margin="0,0,0,6" />
                        <TextBlock Text="Mindestens 10 Zeichen, Gross-/Kleinbuchstaben und eine Zahl." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>

                    <CheckBox x:Name="RememberMeCheckBox" Content="Auf diesem Gerät eingeloggt bleiben"
                              Checked="RememberMe_Changed" Unchecked="RememberMe_Changed"
                              FontWeight="SemiBold" Margin="0,4,0,4" />
                    <TextBlock Text="Bei späteren Starts genügt dann ein 4-stelliger Zugangs-PIN."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,10" />

                    <StackPanel x:Name="PinSetupPanel" Visibility="Collapsed">
                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <TextBlock Text="PIN einrichten: genau 4 Ziffern. Der PIN wird nur als kryptografischer Prüfwert gespeichert."
                                       Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="Zugangs-PIN" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <PasswordBox x:Name="AccessPinBox" Height="38" MaxLength="4" Margin="0,0,0,10" />
                        <TextBlock Text="PIN bestätigen" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <PasswordBox x:Name="ConfirmAccessPinBox" Height="38" MaxLength="4" Margin="0,0,0,12" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StatusBlock" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="22" Margin="0,0,0,10" />
                <Button x:Name="SubmitButton" Content="Anmelden" Height="38" Click="Submit_Click" IsDefault="True" Style="{StaticResource PrimaryActionButtonStyle}" />
                <Button Content="Abbrechen" Margin="0,8,0,0" Click="Cancel_Click" IsCancel="True" Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
