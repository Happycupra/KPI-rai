<UserControl x:Class="Produktionsplanung.App.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Schichten" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock Text="Schichtzeiten und Pausen zentral verwalten."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SectionCardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat={}{0:hh\\:mm}}" Width="90"/>
                        <DataGridTextColumn Header="Ende" Binding="{Binding EndTime, StringFormat={}{0:hh\\:mm}}" Width="90"/>
                        <DataGridTextColumn Header="Pause (Min.)" Binding="{Binding BreakMinutes}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                <StackPanel>
                    <TextBlock Text="Schicht bearbeiten" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,16"/>
                    <TextBlock Text="Name"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                    <TextBlock Text="Startzeit (HH:mm)"/><TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                    <TextBlock Text="Endzeit (HH:mm)"/><TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                    <TextBlock Text="Pause in Minuten"/><TextBox Text="{Binding BreakMinutes}" Margin="0,4,0,16"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Neu" Command="{Binding NewShiftCommand}" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Speichern" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}"/>
                        <Button Content="In Papierkorb" Command="{Binding DeleteCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
