<UserControl x:Class="Produktionsplanung.App.Views.WorkstationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Arbeitsplätze / Produktionslinien" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock Text="Maschinen, Besetzung, Qualifikationen und individuelle Schichtmodelle verwalten."
                       Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="610"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCardStyle}" Padding="14">
                <DataGrid ItemsSource="{Binding Workstations}" SelectedItem="{Binding SelectedWorkstation}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.35*"/>
                        <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="*"/>
                        <DataGridTextColumn Header="Schichtbetrieb" Binding="{Binding ShiftModelSummary}" Width="1.25*"/>
                        <DataGridTextColumn Header="Pflicht-Skill" Binding="{Binding RequiredQualification.Name, TargetNullValue=–}" Width="1.2*"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinimumStaff}" Width="48"/>
                        <DataGridTextColumn Header="Opt" Binding="{Binding OptimalStaff}" Width="48"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaximumStaff}" Width="48"/>
                        <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="52"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Arbeitsplatz bearbeiten" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Name" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bereich / Ort" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Mindestbesetzung"/><TextBox Text="{Binding MinimumStaff}" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Optimal"/><TextBox Text="{Binding OptimalStaff}" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Maximum"/><TextBox Text="{Binding MaximumStaff}" Margin="0,4,0,0"/></StackPanel>
                        </Grid>

                        <Border Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Schichtbetrieb dieser Maschine" Style="{StaticResource CardTitleTextStyle}" FontSize="16"/>
                                        <TextBlock Text="Nur freigegebene Schichten werden bei neuen Produktionsläufen verwendet. Wochentage können je Schicht unterschiedlich sein."
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource InfoChipStyle}" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ShiftModelText}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,12,0,10">
                                    <TextBlock Text="Schnellwahl:" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/>
                                    <Button Content="1-Schicht" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="1" Style="{StaticResource CompactButtonStyle}" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="2-Schicht" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="2" Style="{StaticResource CompactButtonStyle}" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="3-Schicht" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="3" Style="{StaticResource CompactButtonStyle}" Padding="10,4" Margin="0,0,12,0"/>
                                    <Button Content="Mo–Fr" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="MoFr" Style="{StaticResource CompactButtonStyle}" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="7 Tage" Command="{Binding ApplyShiftPresetCommand}" CommandParameter="7Tage" Style="{StaticResource CompactButtonStyle}" Padding="10,4"/>
                                </WrapPanel>

                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="7,5" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/><ColumnDefinition Width="150"/><ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="AN" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="SCHICHT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Grid.Column="2" Text="ZEIT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Grid.Column="3" Text="MO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="DI" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="MI" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="DO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="FR" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="SA" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="SO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding ShiftRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="7,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38"/><ColumnDefinition Width="150"/><ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ShiftName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                    <CheckBox Grid.Column="3" IsChecked="{Binding Monday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="4" IsChecked="{Binding Tuesday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="5" IsChecked="{Binding Wednesday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="6" IsChecked="{Binding Thursday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="7" IsChecked="{Binding Friday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="8" IsChecked="{Binding Saturday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                    <CheckBox Grid.Column="9" IsChecked="{Binding Sunday}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Bestehende Produktionsschichten werden beim Ändern dieses Modells nicht automatisch verschoben. SolutionCompakt warnt stattdessen beim Speichern."
                                           Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Qualifikationspflicht" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                <TextBlock Text="Nur entsprechend qualifizierte Mitarbeitende werden vorgeschlagen; Fehlplanungen erscheinen als Skill-Warnung."
                                           Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Pflichtqualifikation"/>
                                <ComboBox ItemsSource="{Binding Qualifications}" SelectedItem="{Binding SelectedRequiredQualification, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mindest-Skill-Level"/>
                                <ComboBox ItemsSource="{Binding SkillLevels}" SelectedItem="{Binding SelectedRequiredQualificationLevel, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Arbeitsplatz aktiv" IsChecked="{Binding IsActive}" Margin="0,2,0,14"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="Neu" Command="{Binding NewWorkstationCommand}" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Speichern" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}"/>
                            <Button Content="In Papierkorb" Command="{Binding DeleteCommand}" Style="{StaticResource DangerActionButtonStyle}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
