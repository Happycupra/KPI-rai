rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function companyActive(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)) &&
             get(/databases/$(database)/documents/companies/$(companyId)).data.isActive != false;
    }

    function sameCompany(companyId) {
      return signedIn() &&
             request.auth.token.companyId == companyId &&
             companyActive(companyId);
    }

    function isCompanyAdmin(companyId) {
      return sameCompany(companyId) &&
             request.auth.token.role == "Administrator";
    }

    // Licensing and vendor support credentials are never exposed directly to clients.
    // They are accessible only through privileged Cloud Functions.
    match /licenses/{installationId} {
      allow read, write: if false;
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow write: if false;

      match /weekPlans/{weekId} {
        allow read: if sameCompany(companyId);
        allow write: if false;

        match /entries/{entryId} {
          allow read: if sameCompany(companyId);
          allow write: if false;
        }

        match /productionSlots/{slotId} {
          allow read: if sameCompany(companyId);
          allow write: if false;
        }

        // Admin changes stay separate from the published desktop snapshot.
        // This keeps SolutionCompakt as the source of truth.
        match /overrides/{entryId} {
          allow read: if sameCompany(companyId);
          allow create, update, delete: if isCompanyAdmin(companyId);
        }
      }

      // Password hashes are server-side only. No browser client may read them.
      match /authUsers/{userId} {
        allow read, write: if false;
      }
    }
  }
}
