rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function companyActive(companyId) {
      let company = get(/databases/$(database)/documents/companies/$(companyId)).data;
      let license = get(/databases/$(database)/documents/licenses/$(company.licenseInstallationId)).data;
      return company.isActive != false && license.status == "active" &&
             license.validUntil > request.time;
    }

    function currentUser(companyId) {
      let userId = string(request.auth.token.sourceUserId);
      let user = get(/databases/$(database)/documents/companies/$(companyId)/authUsers/$(userId)).data;
      return user.isActive == true && user.role == request.auth.token.role &&
             user.get('credentialVersion', 'legacy') == request.auth.token.get('credentialVersion', 'legacy');
    }

    function sameCompany(companyId) {
      return signedIn() && request.auth.token.companyId == companyId &&
             companyActive(companyId) && currentUser(companyId);
    }

    function isCompanyAdmin(companyId) {
      return sameCompany(companyId) &&
             request.auth.token.role == "Administrator";
    }

    // Licensing and vendor support credentials are never exposed directly to clients.
    // They are accessible only through privileged Cloud Functions.
    match /licenses/{installationId} {
      allow read, write: if false;
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow write: if false;

      match /weekPlans/{weekId} {
        allow read: if sameCompany(companyId);
        allow write: if false;

        match /entries/{entryId} {
          allow read: if sameCompany(companyId);
          allow write: if false;
        }

        match /productionSlots/{slotId} {
          allow read: if sameCompany(companyId);
          allow write: if false;
        }

        // Immutable upload versions are readable only after complete publication.
        match /versions/{versionId}/{collectionName}/{entryId} {
          allow read: if collectionName in ['entries', 'productionSlots'] &&
            sameCompany(companyId) &&
            get(/databases/$(database)/documents/companies/$(companyId)/weekPlans/$(weekId)).data.activeVersion == versionId;
          allow write: if false;
        }

        // Admin changes stay separate from the published desktop snapshot.
        // This keeps SolutionCompakt as the source of truth.
        match /overrides/{entryId} {
          allow read: if sameCompany(companyId);
          allow create, update, delete: if isCompanyAdmin(companyId);
        }
      }

      // Password hashes are server-side only. No browser client may read them.
      match /authUsers/{userId} {
        allow read, write: if false;
      }
    }
  }
}
