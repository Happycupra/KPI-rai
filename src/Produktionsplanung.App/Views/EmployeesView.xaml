<UserControl x:Class="Produktionsplanung.App.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Mitarbeiter" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Mitarbeiter anlegen, bearbeiten, aktivieren oder deaktivieren" Foreground="#64748B" Margin="0,4,0,18" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Height="36" Padding="10,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nach Name, Personalnummer, Funktion oder Abteilung suchen" />
            <CheckBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Content="Inaktive anzeigen" IsChecked="{Binding ShowInactive}" />
            <Button Grid.Column="3" Content="+ Neuer Mitarbeiter" Command="{Binding NewEmployeeCommand}" Padding="16,8" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12">
                <DataGrid ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Personalnr." Binding="{Binding PersonnelNumber}" Width="110" />
                        <DataGridTextColumn Header="Name" Binding="{Binding LastName}" Width="*" />
                        <DataGridTextColumn Header="Vorname" Binding="{Binding FirstName}" Width="*" />
                        <DataGridTextColumn Header="Funktion" Binding="{Binding Role}" Width="1.4*" />
                        <DataGridTextColumn Header="Abteilung" Binding="{Binding Department}" Width="1.2*" />
                        <DataGridTextColumn Header="Pensum" Binding="{Binding WorkloadPercent, StringFormat={}{0}%}" Width="80" />
                        <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <TextBlock Text="Personalnummer *" Foreground="#475569" />
                        <TextBox Text="{Binding PersonnelNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Height="34" Padding="8,5" />

                        <TextBlock Text="Vorname *" Foreground="#475569" />
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Height="34" Padding="8,5" />

                        <TextBlock Text="Nachname *" Foreground="#475569" />
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Height="34" Padding="8,5" />

                        <TextBlock Text="Funktion" Foreground="#475569" />
                        <TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Height="34" Padding="8,5" />

                        <TextBlock Text="Abteilung" Foreground="#475569" />
                        <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Height="34" Padding="8,5" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pensum %" Foreground="#475569" />
                                <TextBox Text="{Binding WorkloadPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="34" Padding="8,5" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sollstunden / Woche" Foreground="#475569" />
                                <TextBox Text="{Binding WeeklyTargetHours, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Height="34" Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Mitarbeiter aktiv" IsChecked="{Binding IsActive}" Margin="0,0,0,18" />

                        <WrapPanel>
                            <Button Content="Speichern" Command="{Binding SaveCommand}" Padding="18,8" Margin="0,0,8,8" />
                            <Button Content="Deaktivieren" Command="{Binding DeactivateCommand}" Padding="14,8" Margin="0,0,8,8" />
                            <Button Content="Aktivieren" Command="{Binding ActivateCommand}" Padding="14,8" Margin="0,0,8,8" />
                            <Button Content="Löschen" Command="{Binding DeleteCommand}" Padding="14,8" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
