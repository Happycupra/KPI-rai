<UserControl x:Class="Produktionsplanung.App.Views.WorkTimeCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Arbeitszeit &amp; Betriebskalender" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="{Binding MonthText}" FontSize="15" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="‹" Width="38" Height="34" Command="{Binding PreviousMonthCommand}" Margin="0,0,6,0"/>
                <Button Content="Aktueller Monat" Height="34" Padding="14,0" Command="{Binding CurrentMonthCommand}" Margin="0,0,6,0"/>
                <Button Content="›" Width="38" Height="34" Command="{Binding NextMonthCommand}" Margin="0,0,12,0"/>
                <Button Content="Aktualisieren" Height="34" Padding="14,0" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Arbeitszeitkonto">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="0.9*"/><RowDefinition Height="14"/><RowDefinition Height="1.1*"/></Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Soll / Plan / Ist je Mitarbeiter" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Balances}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="2*"/>
                                    <DataGridTextColumn Header="Soll h" Binding="{Binding TargetHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Plan h" Binding="{Binding PlannedHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Ist h" Binding="{Binding ActualHours, StringFormat=0.0}" Width="80"/>
                                    <DataGridTextColumn Header="Saldo h" Binding="{Binding BalanceHours, StringFormat=+0.0;-0.0;0.0}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Erfasste Arbeitszeiten" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="100"/>
                                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="105"/>
                                    <DataGridTextColumn Header="Pause" Binding="{Binding BreakMinutes}" Width="65"/>
                                    <DataGridTextColumn Header="Netto h" Binding="{Binding NetHours, StringFormat=0.00}" Width="75"/>
                                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Grid.RowSpan="3" Background="White" CornerRadius="10" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Arbeitszeit erfassen" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <TextBlock Text="Mitarbeiter" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="34" Margin="0,4,0,12"/>
                                <TextBlock Text="Datum" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding EntryDate, Mode=TwoWay}" Height="34" Margin="0,4,0,12"/>
                                <TextBlock Text="Start (HH:mm)" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                                <TextBlock Text="Ende (HH:mm)" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                                <TextBlock Text="Pause Minuten" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding BreakMinutes}" Height="32" Margin="0,4,0,12"/>
                                <TextBlock Text="Kommentar" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding EntryComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                <Button Content="Speichern" Command="{Binding SaveEntryCommand}" Height="36" Margin="0,0,0,7"/>
                                <Button Content="Neu" Command="{Binding NewEntryCommand}" Height="36" Margin="0,0,0,7"/>
                                <Button Content="Löschen" Command="{Binding DeleteEntryCommand}" Height="36"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Betriebskalender">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Kalender-Ausnahmen" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Ohne Ausnahme gilt automatisch Montag bis Freitag als Arbeitstag. Hinterlege hier Feiertage, Betriebsferien, halbe Tage oder Sonderarbeitstage." Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <DataGrid ItemsSource="{Binding CalendarDays}" SelectedItem="{Binding SelectedCalendarDay, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="120"/>
                                    <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Typ" Binding="{Binding WorkingDayText}" Width="90"/>
                                    <DataGridTextColumn Header="Soll-Faktor" Binding="{Binding FactorText}" Width="85"/>
                                    <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Kalendertag bearbeiten" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <TextBlock Text="Datum" FontWeight="SemiBold"/>
                            <DatePicker SelectedDate="{Binding CalendarDate, Mode=TwoWay}" Height="34" Margin="0,4,0,12"/>
                            <TextBlock Text="Bezeichnung" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CalendarName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,12"/>
                            <CheckBox Content="Arbeitstag / Sonderarbeitstag" IsChecked="{Binding CalendarIsWorkingDay}" Margin="0,2,0,12"/>
                            <TextBlock Text="Sollstunden-Faktor" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CalendarTargetHoursFactor}" Height="32" Margin="0,4,0,5"/>
                            <TextBlock Text="0 = frei · 0.5 = halber Tag · 1 = normal · bis 2 möglich" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>
                            <TextBlock Text="Kommentar" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CalendarComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,14"/>
                            <Button Content="Speichern" Command="{Binding SaveCalendarDayCommand}" Height="36" Margin="0,0,0,7"/>
                            <Button Content="Neu" Command="{Binding NewCalendarDayCommand}" Height="36" Margin="0,0,0,7"/>
                            <Button Content="Ausnahme löschen" Command="{Binding DeleteCalendarDayCommand}" Height="36"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
