<Window x:Class="Produktionsplanung.App.Views.ProviderAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lizenzverwaltung" Width="1080" Height="720" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Lizenzverwaltung" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Firmenregistrierungen und Lizenzen zentral verwalten."
                       Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="LoginPanel" Grid.Row="1" MaxWidth="480" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderThickness="1" CornerRadius="12" BorderBrush="#D7E1EA">
            <StackPanel>
                <TextBlock Text="Anbieter anmelden" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Text="E-Mail" />
                <TextBox x:Name="OwnerEmail" IsReadOnly="True" Margin="0,4,0,12" />
                <TextBlock Text="Passwort" />
                <PasswordBox x:Name="OwnerPassword" Margin="0,4,0,16" KeyDown="OwnerPassword_KeyDown" />
                <Button x:Name="LoginButton" Content="Sicher anmelden" Click="Login_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
                <TextBlock x:Name="LoginStatus" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid x:Name="AdminPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <TextBlock x:Name="CountLabel" VerticalAlignment="Center" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Neu laden" Click="Reload_Click" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Abmelden" Click="Logout_Click" Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </DockPanel>

            <DataGrid x:Name="LicenseGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" HeadersVisibility="Column"
                      SelectionChanged="LicenseGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Firma" Binding="{Binding CompanyName}" Width="2*" />
                    <DataGridTextColumn Header="Kontakt" Binding="{Binding ContactEmail}" Width="1.7*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding EffectiveStatus}" Width="100" />
                    <DataGridTextColumn Header="Gültig bis" Binding="{Binding ValidUntilText}" Width="150" />
                    <DataGridTextColumn Header="Version" Binding="{Binding LastAppVersion}" Width="90" />
                    <DataGridTextColumn Header="Letzte Prüfung" Binding="{Binding LastCheckedText}" Width="150" />
                    <DataGridTextColumn Header="Installation" Binding="{Binding InstallationId}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Gültig bis:" VerticalAlignment="Center" Margin="0,0,6,8" FontWeight="SemiBold" />
                    <DatePicker x:Name="ValidUntilPicker" Width="145" Margin="0,0,6,8" />
                    <Button Content="Datum setzen" Click="SetExpiry_Click" Margin="0,0,18,8" Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="+7 Tage" Tag="7" Click="Extend_Click" Margin="0,0,8,8" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="+30 Tage" Tag="30" Click="Extend_Click" Margin="0,0,8,8" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="+90 Tage" Tag="90" Click="Extend_Click" Margin="0,0,8,8" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="+365 Tage" Tag="365" Click="Extend_Click" Margin="0,0,12,8" Style="{StaticResource ActionButtonStyle}" />
                </WrapPanel>
                <WrapPanel>
                    <TextBox x:Name="CustomDays" Width="80" Margin="0,0,6,8" VerticalContentAlignment="Center" ToolTip="1 bis 3650 Tage" />
                    <Button Content="+ Tage" Click="CustomExtend_Click" Margin="0,0,12,8" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Sperren" Click="Suspend_Click" Margin="0,0,8,8" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Recovery-Code" Click="Recovery_Click" Margin="0,0,8,8" Style="{StaticResource ActionButtonStyle}" />
                </WrapPanel>
                <TextBlock x:Name="AdminStatus" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Button Grid.Row="2" Content="Schliessen" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource ActionButtonStyle}" />
    </Grid>
</Window>
