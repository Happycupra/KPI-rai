<UserControl x:Class="Produktionsplanung.App.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mitarbeiter" FontSize="27" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding VisibleEmployeeCount}" FontSize="11"
                               Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text=" Mitarbeitende in der Liste · aufklappen für Details"
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="+ Neuer Mitarbeiter"
                    Click="NewEmployee_Click"
                    Height="36" Padding="16,0"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="34" Padding="10,5"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Nach Name, Personalnummer, Funktion, Abteilung oder Skill suchen"/>

            <ComboBox Grid.Column="1" Height="34" Margin="10,0,0,0"
                      ItemsSource="{Binding GroupModeOptions}"
                      SelectedItem="{Binding SelectedGroupMode, Mode=TwoWay}"
                      ToolTip="Mitarbeiterliste gruppieren"/>

            <CheckBox Grid.Column="2" Content="Inaktive anzeigen"
                      IsChecked="{Binding ShowInactive}"
                      VerticalAlignment="Center" Margin="14,0,0,0"/>

            <TextBlock Grid.Column="4" Text="{Binding StatusMessage}"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="360"/>

            <Expander Grid.Row="1" Grid.ColumnSpan="5" Header="Qualifikationen / Skills verwalten" Margin="0,8,0,0">
                <Border Background="#F8FBFF" BorderBrush="#DFE8F1" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="32" Padding="8,4"
                                 Text="{Binding NewQualificationName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Neue Qualifikation"/>
                        <Button Grid.Column="1" Content="+ Skill" Command="{Binding AddQualificationCommand}"
                                Padding="11,5" Margin="7,0,0,0"/>
                        <ComboBox Grid.Column="3" Height="32" ItemsSource="{Binding Qualifications}"
                                  DisplayMemberPath="Name" SelectedItem="{Binding SelectedQualification}"/>
                        <Button Grid.Column="4" Content="Löschen" Command="{Binding DeleteQualificationCommand}"
                                Padding="11,5" Margin="7,0,0,0"/>
                        <TextBlock Grid.Column="5" Text="Skill-Level werden direkt beim Mitarbeiter gepflegt."
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                    </Grid>
                </Border>
            </Expander>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="11" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding EmployeeRows}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#EEF5FB" CornerRadius="6" Padding="9,5" Margin="0,5,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,6"
                                          Background="#FCFDFE"
                                          BorderBrush="#DFE8F1"
                                          BorderThickness="1"
                                          Padding="0"
                                          ToolTip="Aufklappen für Details · Rechtsklick zum Bearbeiten">
                                    <Expander.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Bearbeiten"
                                                      Click="EditEmployeeMenuItem_Click"/>
                                        </ContextMenu>
                                    </Expander.ContextMenu>

                                    <Expander.Header>
                                        <Grid Margin="8,7,10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="38" Height="38" CornerRadius="19"
                                                    Background="{StaticResource PrimarySoftBrush}">
                                                <TextBlock Text="{Binding Initials}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PersonnelNumber, StringFormat='Pers.-Nr. {0}'}"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding Role}" FontSize="11"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Department}" FontSize="9.5"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="4" Text="{Binding WorkloadText}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"/>

                                            <Border Grid.Column="5"
                                                    Background="{Binding StatusBackground}"
                                                    CornerRadius="11" Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{Binding StatusForeground}"
                                                           FontSize="9.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>

                                    <Border Background="#F8FBFF" BorderBrush="#E4ECF4"
                                            BorderThickness="0,1,0,0" Padding="16,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="FUNKTION" FontSize="8.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding Role}" Margin="0,3,0,0"
                                                           Foreground="{StaticResource TextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ABTEILUNG" FontSize="8.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding Department}" Margin="0,3,0,0"
                                                           Foreground="{StaticResource TextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="ARBEITSZEIT" FontSize="8.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding WorkloadText}" Margin="0,3,0,0"
                                                           Foreground="{StaticResource TextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Margin="12,0,0,0">
                                                <TextBlock Text="QUALIFIKATIONEN" FontSize="8.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding QualificationSummary}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="Rechtsklick auf den Mitarbeiter → Bearbeiten"
                                                           Margin="0,7,0,0" FontSize="9"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border x:Name="EmployeeEditorPanel" Grid.Column="2" Width="430"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="11" Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding EditorTitle}" FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Alle Mitarbeiter-Stammdaten"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Width="32" Height="32"
                                FontSize="17" Padding="0"
                                ToolTip="Bearbeitung schliessen"
                                Click="CloseEditor_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Personalnummer *" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding PersonnelNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,10" Height="32" Padding="8,4"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Vorname *" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,10" Height="32" Padding="8,4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nachname *" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,10" Height="32" Padding="8,4"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Funktion" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,10" Height="32" Padding="8,4"/>

                            <TextBlock Text="Abteilung" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,10" Height="32" Padding="8,4"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Pensum %" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding WorkloadPercent, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,10" Height="32" Padding="8,4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sollstunden / Woche" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding WeeklyTargetHours, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,4,0,10" Height="32" Padding="8,4"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Mitarbeiter aktiv"
                                      IsChecked="{Binding IsActive}" Margin="0,4,0,12"/>

                            <Border Background="#F8FBFF" BorderBrush="#E2EAF2"
                                    BorderThickness="1" CornerRadius="7" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Skills / Qualifikationen" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="0 = keine · 1 = Ausbildung · 2 = qualifiziert · 3 = Experte/Trainer"
                                               FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8"/>
                                    <ItemsControl ItemsSource="{Binding SkillEditorRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding QualificationName}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ComboBox Grid.Column="1" Height="28" SelectedIndex="{Binding Level, Mode=TwoWay}">
                                                        <ComboBoxItem Content="0 · keine"/>
                                                        <ComboBoxItem Content="1 · Ausbildung"/>
                                                        <ComboBoxItem Content="2 · qualifiziert"/>
                                                        <ComboBoxItem Content="3 · Experte"/>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Noch keine Qualifikationen angelegt." FontSize="9.5"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SkillEditorRows.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Button Content="Deaktivieren" Command="{Binding DeactivateCommand}"
                                    Padding="11,6" Margin="0,0,6,0"/>
                            <Button Content="Aktivieren" Command="{Binding ActivateCommand}"
                                    Padding="11,6" Margin="0,0,6,0"/>
                            <Button Content="Löschen" Command="{Binding DeleteCommand}"
                                    Padding="11,6"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="Speichern"
                                Command="{Binding SaveCommand}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                Padding="18,7" Margin="10,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
