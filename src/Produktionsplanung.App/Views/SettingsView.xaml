<UserControl x:Class="Produktionsplanung.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Einstellungen" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Unternehmensdaten, Datensicherung, Sicherheit, Export und persönliche Oberfläche verwalten."
                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Einstellungen speichern"
                    VerticalAlignment="Center" Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,14,6,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Unternehmen" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Firmen- und Standortangaben für Berichte und Exporte."
                                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />
                                    <TextBlock Text="Firmenname" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                    <TextBlock Text="Standort / Werk" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Lokale Speicherorte" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Die operative Datenbank und Anwendungseinstellungen liegen lokal bzw. im Portable-Datenpfad."
                                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />
                                    <TextBlock Text="Datenbank" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,3,0,10" />
                                    <TextBlock Text="Einstellungen" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,3,0,14" />
                                    <Button Content="Datenordner öffnen" HorizontalAlignment="Left"
                                            Command="{Binding OpenDataDirectoryCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Daten &amp; Backup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,14,6,16">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Backup &amp; Wiederherstellung" Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Ein .kpibackup enthält einen konsistenten SQLite-Snapshot, Anwendungseinstellungen und Backup-Metadaten. Vor einer Wiederherstellung wird automatisch ein Sicherheitsbackup erstellt."
                                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Backup-Ordner" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Text="{Binding DefaultBackupDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Auswählen" Margin="0,0,8,0"
                                            Command="{Binding BrowseBackupDirectoryCommand}" />
                                    <Button Grid.Column="3" Content="Öffnen" Command="{Binding OpenBackupDirectoryCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Automatik" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <CheckBox Grid.Column="1" Content="Auto-Backup beim Beenden"
                                              IsChecked="{Binding AutoBackupOnExit}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Behalten:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding BackupRetentionCount, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="52" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Text="Automatische Backups werden nach Anzahl begrenzt; manuelle Sicherheitsbackups bleiben erhalten."
                                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>

                                <WrapPanel>
                                    <Button Content="Backup jetzt erstellen" Command="{Binding CreateBackupCommand}" Margin="0,0,8,8"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="Backup wiederherstellen" Command="{Binding RestoreBackupCommand}" Margin="0,0,8,8" />
                                    <Button Content="SolutionCompakt neu starten" Command="{Binding RestartApplicationCommand}" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Sicherheit">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,14,6,16">
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Recovery-Code" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Der Recovery-Code ist der Notfallzugang für ein vergessenes Passwort. Gespeichert werden nur Hash und Salt."
                                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,10" />
                                    <TextBlock Text="{Binding RecoveryCodeStatus}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Beim Erneuern wird der bisherige Code sofort ungültig."
                                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,20,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Recovery-Code erneuern" VerticalAlignment="Center"
                                        Command="{Binding ManageRecoveryCodeCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Automatische Sitzungssperre" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Bei Inaktivität wird die Anwendung gesperrt. Entsperren kann nur derselbe Benutzer mit seinem Passwort; offene Eingaben bleiben erhalten."
                                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,24,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Aktiv" IsChecked="{Binding AutoLockEnabled}" Margin="0,0,14,0" />
                                    <TextBlock Text="Nach" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <ComboBox ItemsSource="{Binding AutoLockOptions}" SelectedItem="{Binding AutoLockMinutes}" Width="78" />
                                    <TextBlock Text="Min." VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,14,6,16">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="CSV-Export" Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Der Komplett-Export erstellt getrennte CSV-Dateien für Mitarbeiter, Skills, Arbeitsplätze, Schichten, Abwesenheiten, Planung, Produktionsaufträge, Ist-Produktion/OEE und Stillstände."
                                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Export-Ordner" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Text="{Binding DefaultExportDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Auswählen" Margin="0,0,8,0"
                                            Command="{Binding BrowseExportDirectoryCommand}" />
                                    <Button Grid.Column="3" Content="Öffnen" Command="{Binding OpenExportDirectoryCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CSV-Trennzeichen" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Text="{Binding CsvDelimiter, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="1" Width="48" HorizontalAlignment="Left" />
                                    <CheckBox Grid.Column="2" Content="UTF-8 BOM für Excel" IsChecked="{Binding IncludeUtf8Bom}" />
                                    <TextBlock Grid.Column="3" Text="Semikolon ist für deutschsprachige Excel-Installationen meist am praktischsten."
                                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>

                                <Button Content="Alle Daten als CSV exportieren" HorizontalAlignment="Left"
                                        Command="{Binding ExportAllCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Benutzeroberfläche">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,14,6,16">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Persönliche Ansicht" Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Sidebar, aufgeklappte Menügruppen sowie Kalenderansicht und Filter werden pro angemeldetem Benutzer gespeichert. Änderungen anderer Benutzer beeinflussen deine Ansicht nicht."
                                           Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,16" />
                                <Border Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <TextBlock Text="Mit Zurücksetzen werden Navigation und Kalenderfilter auf die Standardansicht gestellt. Die vollständige Navigation wird beim nächsten Anmelden neu geladen."
                                               Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" />
                                </Border>
                                <Button Content="Persönliche Ansicht zurücksetzen" HorizontalAlignment="Left"
                                        Command="{Binding ResetUiPreferencesCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,4,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
