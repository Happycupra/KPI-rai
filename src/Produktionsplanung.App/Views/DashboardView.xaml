<UserControl x:Class="Produktionsplanung.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Produktionsplanung.App.Views"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <Style x:Key="DashboardMetricValue" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="DashboardMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}" />
        <Style x:Key="DashboardCompactMetricValue" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="DashboardDayMetricButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MetricChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MetricChrome" Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
                                <Setter TargetName="MetricChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MetricChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MetricChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}">
            <Grid Margin="{StaticResource PageHeaderSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Betriebsübersicht" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Heute: Personal, Aufträge, Linien und Handlungsbedarf auf einen Blick."
                               Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="↻  Aktualisieren" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding RefreshCommand}" Click="RefreshBatches_Click" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="Schnellzugriff" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Direkt zum nächsten Arbeitsschritt" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Planung öffnen" Style="{StaticResource ActionButtonStyle}" Click="OpenPlanning_Click" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Aufträge" Style="{StaticResource ActionButtonStyle}" Click="OpenOrders_Click" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Content="Fertigungssteuerung" Style="{StaticResource ActionButtonStyle}" Click="OpenControl_Click" Margin="0,0,8,0" />
                    <Button Grid.Column="4" Content="Ist-Produktion / OEE" Style="{StaticResource PrimaryActionButtonStyle}" Click="OpenActual_Click" />
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Personalabdeckung" Style="{StaticResource DashboardMetricLabel}" />
                            <TextBlock Text="{Binding PersonnelCoveragePercent, StringFormat={}{0}%}" Style="{StaticResource DashboardMetricValue}" Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="heute gedeckter Bedarf" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8">
                            <TextBlock Text="✓" Foreground="{StaticResource PrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Laufende Chargen" Style="{StaticResource DashboardMetricLabel}" />
                            <TextBlock Text="{Binding RunningOrders}" Style="{StaticResource DashboardMetricValue}" Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="aktuell in Produktion" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource InfoSoftBrush}" CornerRadius="8">
                            <TextBlock Text="▶" Foreground="{StaticResource InfoBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Handlungsbedarf" Style="{StaticResource DashboardMetricLabel}" />
                            <TextBlock Text="{Binding OpenProblems}" Style="{StaticResource DashboardMetricValue}" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="offene Hinweise &amp; Probleme" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource DangerSoftBrush}" CornerRadius="8">
                            <TextBlock Text="!" Foreground="{StaticResource DangerBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chargen heute" Style="{StaticResource DashboardMetricLabel}" />
                            <TextBlock Text="{Binding OrdersToday}" Style="{StaticResource DashboardMetricValue}" />
                            <TextBlock Text="geplante Aufträge" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8">
                            <TextBlock Text="▤" Foreground="{StaticResource MutedTextBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Artikel" Click="OpenArticles_Click" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" />
                            <Button Content="Abgeschlossene Chargen" Click="OpenArchive_Click" Style="{StaticResource ActionButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Text="Chargenübersicht" Style="{StaticResource SectionHeaderTextStyle}" />
                    </DockPanel>
                    <views:BatchBrowserView x:Name="Batches" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertCardStyle}">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackupStatusSeverity}" Value="Gelb">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BackupStatusSeverity}" Value="Rot">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource CardBrush}" Margin="0,0,12,0">
                        <TextBlock Text="↥" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackupStatusSeverity}" Value="Gelb"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding BackupStatusSeverity}" Value="Rot"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Datensicherung" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="{Binding BackupStatusText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Konfliktzentrale" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="Engpässe, Qualifikationen, Abwesenheiten und überfällige Aufträge" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DangerChipStyle}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding OpenProblems, StringFormat=⚠ {0} offen}" Foreground="{StaticResource DangerBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OpenProblems}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AlertCardStyle}" Background="{StaticResource SubtleSurfaceBrush}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border x:Name="SeverityChip" Style="{StaticResource DangerChipStyle}" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock x:Name="SeverityText" Text="KRITISCH" Foreground="{StaticResource DangerBrush}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Öffnen" Style="{StaticResource SecondaryButtonStyle}" Click="OpenIssue_Click" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Gelb">
                                        <Setter TargetName="SeverityChip" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        <Setter TargetName="SeverityChip" Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                                        <Setter TargetName="SeverityText" Property="Text" Value="WARNUNG" />
                                        <Setter TargetName="SeverityText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource SuccessSoftBrush}"
                            BorderBrush="{StaticResource SuccessBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OpenProblems}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✓  Keine offenen Probleme für heute." Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Tagesübersicht" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock Grid.Column="1" Text="Kachel anklicken für Details" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </Grid>
            <UniformGrid Columns="6" Margin="0,0,0,12">
                <Button Tag="Active" Style="{StaticResource DashboardDayMetricButtonStyle}" Click="DailyMetric_Click" Margin="0,0,10,0" AutomationProperties.Name="Details zu aktiven Mitarbeitenden">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Aktiv" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding ActiveEmployees}" Style="{StaticResource DashboardCompactMetricValue}" /></StackPanel><TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="18" VerticalAlignment="Center" /></Grid>
                </Button>
                <Button Tag="Available" Style="{StaticResource DashboardDayMetricButtonStyle}" Click="DailyMetric_Click" Margin="0,0,10,0" AutomationProperties.Name="Details zu verfügbaren Mitarbeitenden">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Verfügbar" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding AvailableEmployees}" Style="{StaticResource DashboardCompactMetricValue}" Foreground="{StaticResource SuccessBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="18" VerticalAlignment="Center" /></Grid>
                </Button>
                <Button Tag="Planned" Style="{StaticResource DashboardDayMetricButtonStyle}" Click="DailyMetric_Click" Margin="0,0,10,0" AutomationProperties.Name="Details zu eingeplanten Mitarbeitenden">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Eingeplant" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding PlannedEmployees}" Style="{StaticResource DashboardCompactMetricValue}" Foreground="{StaticResource PrimaryBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="18" VerticalAlignment="Center" /></Grid>
                </Button>
                <Button Tag="Absent" Style="{StaticResource DashboardDayMetricButtonStyle}" Click="DailyMetric_Click" Margin="0,0,10,0" AutomationProperties.Name="Details zu abwesenden Mitarbeitenden">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Abwesend" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding AbsentEmployees}" Style="{StaticResource DashboardCompactMetricValue}" Foreground="{StaticResource WarningBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="18" VerticalAlignment="Center" /></Grid>
                </Button>
                <Button Tag="Completed" Style="{StaticResource DashboardDayMetricButtonStyle}" Click="DailyMetric_Click" Margin="0,0,10,0" AutomationProperties.Name="Details zu heute abgeschlossenen Aufträgen">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Abgeschlossen" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding CompletedOrdersToday}" Style="{StaticResource DashboardCompactMetricValue}" Foreground="{StaticResource SuccessBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="18" VerticalAlignment="Center" /></Grid>
                </Button>
                <Button Tag="Understaffed" Style="{StaticResource DashboardDayMetricButtonStyle}" Click="DailyMetric_Click" AutomationProperties.Name="Details zu unterbesetzten Aufträgen">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Unterbesetzt" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding UnderstaffedOrders}" Style="{StaticResource DashboardCompactMetricValue}" Foreground="{StaticResource DangerBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="18" VerticalAlignment="Center" /></Grid>
                </Button>
            </UniformGrid>

            <Border x:Name="DailyDetailCard"
                    Style="{StaticResource SectionCardStyle}"
                    Margin="0,0,0,16"
                    Padding="16"
                    Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Polite">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DailyDetailTitle" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Name="DailyDetailDescription" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,3,24,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Style="{StaticResource IconButtonStyle}" Width="34" Height="34" Click="CloseDailyDetails_Click" ToolTip="Details schließen" AutomationProperties.Name="Tagesdetails schließen" />
                    </Grid>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                            <StackPanel><TextBlock x:Name="DailyDetailStat1Label" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DailyDetailStat1Value" Style="{StaticResource DashboardCompactMetricValue}"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                            <StackPanel><TextBlock x:Name="DailyDetailStat2Label" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DailyDetailStat2Value" Style="{StaticResource DashboardCompactMetricValue}"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8" Padding="12">
                            <StackPanel><TextBlock x:Name="DailyDetailStat3Label" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DailyDetailStat3Value" Style="{StaticResource DashboardCompactMetricValue}"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <Button x:Name="DailyDetailActionButton" HorizontalAlignment="Left" Style="{StaticResource PrimaryActionButtonStyle}" Click="DailyDetailAction_Click" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Arbeitsplatzstatus heute" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,10" />
                        <Grid>
                            <DataGrid x:Name="WorkstationStatusGrid" ItemsSource="{Binding WorkstationStatuses}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" MaxHeight="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.25*" />
                                    <DataGridTextColumn Header="Läufe" Binding="{Binding OrderCount}" Width="55" />
                                    <DataGridTextColumn Header="Personal" Binding="{Binding CoverageText}" Width="70" />
                                    <DataGridTemplateColumn Header="Status" Width="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="LineStatusChip" Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="LineStatusText" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Bereit"><Setter TargetName="LineStatusChip" Property="Background" Value="{StaticResource InfoSoftBrush}"/><Setter TargetName="LineStatusChip" Property="BorderBrush" Value="{StaticResource InfoBorderBrush}"/><Setter TargetName="LineStatusText" Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Abgeschlossen"><Setter TargetName="LineStatusChip" Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter TargetName="LineStatusChip" Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/><Setter TargetName="LineStatusText" Property="Text" Value="✓ Abgeschlossen"/><Setter TargetName="LineStatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Personal fehlt"><Setter TargetName="LineStatusChip" Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter TargetName="LineStatusChip" Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/><Setter TargetName="LineStatusText" Property="Text" Value="⚠ Personal fehlt"/><Setter TargetName="LineStatusText" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Problem"><Setter TargetName="LineStatusChip" Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter TargetName="LineStatusChip" Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/><Setter TargetName="LineStatusText" Property="Text" Value="! Problem"/><Setter TargetName="LineStatusText" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Kein Lauf"><Setter TargetName="LineStatusText" Property="Text" Value="— Kein Lauf"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource EmptyStateStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=WorkstationStatusGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Keine Arbeitsplatzdaten für heute." Style="{StaticResource CardTitleTextStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Sobald Läufe geplant sind, erscheint hier deren Status." Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Aufträge heute" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Produkt, Arbeitsplatz, Schicht und aktuelle Personalabdeckung" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,2,0,10" />
                        <Grid>
                            <DataGrid x:Name="TodayOrdersGrid" ItemsSource="{Binding TodayOrders}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" MaxHeight="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Auftrag" Binding="{Binding OrderNumber}" Width="90" />
                                    <DataGridTextColumn Header="Produkt" Binding="{Binding Product}" Width="1.2*" />
                                    <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.05*" />
                                    <DataGridTextColumn Header="Schicht" Binding="{Binding ShiftName}" Width="95" />
                                    <DataGridTextColumn Header="Personal" Binding="{Binding CoverageText}" Width="70" />
                                    <DataGridTemplateColumn Header="Abdeckung" Width="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="CoverageChip" Style="{StaticResource SuccessChipStyle}" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="CoverageText" Text="{Binding CoverageStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding CoverageStatus}" Value="Unterbesetzt"><Setter TargetName="CoverageChip" Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter TargetName="CoverageChip" Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/><Setter TargetName="CoverageText" Property="Text" Value="⚠ Unterbesetzt"/><Setter TargetName="CoverageText" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding CoverageStatus}" Value="Abgeschlossen"><Setter TargetName="CoverageText" Property="Text" Value="✓ Abgeschlossen"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource EmptyStateStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=TodayOrdersGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Heute sind keine Aufträge geplant." Style="{StaticResource CardTitleTextStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Geplante Produktionsaufträge erscheinen automatisch in dieser Übersicht." Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>