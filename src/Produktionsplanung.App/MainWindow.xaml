<Window x:Class="Produktionsplanung.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KPI-rai – Produktionsplanung" Height="820" Width="1450" MinHeight="700" MinWidth="1150"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="KPI-rai" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBlock Text="Produktionsplanung" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,24" />

                    <Button Content="Dashboard" Height="42" Margin="0,0,0,8" Click="ShowDashboard_Click" />
                    <Button Content="Tagesplanung" Height="42" Margin="0,0,0,8" Click="ShowDayPlanning_Click" />
                    <Button Content="Wochenplanung" Height="42" Margin="0,0,0,8" Click="ShowWeekPlanning_Click" />
                    <Button Content="Produktionsaufträge" Height="42" Margin="0,0,0,8" Click="ShowProductionOrders_Click" />
                    <Button Content="Mitarbeiter" Height="42" Margin="0,0,0,8" Click="ShowEmployees_Click" />
                    <Button Content="Skill-Matrix" Height="42" Margin="0,0,0,8" Click="ShowSkills_Click" />
                    <Button Content="Arbeitsplätze" Height="42" Margin="0,0,0,8" Click="ShowWorkstations_Click" />
                    <Button Content="Schichten" Height="42" Margin="0,0,0,8" Click="ShowShifts_Click" />
                    <Button Content="Abwesenheiten" Height="42" Margin="0,0,0,18" Click="ShowAbsences_Click" />

                    <TextBlock Text="NÄCHSTE MODULE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,8" />
                    <Button Content="Auswertungen / KPIs" Height="40" Margin="0,0,0,6" IsEnabled="False" />
                    <Button Content="Einstellungen" Height="40" IsEnabled="False" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="4,14,4,4">
                    <StackPanel>
                        <TextBlock Text="MVP" Foreground="#94A3B8" FontSize="11" />
                        <TextBlock Text="Windows Desktop · SQLite" Foreground="#64748B" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1" />
    </Grid>
</Window>
