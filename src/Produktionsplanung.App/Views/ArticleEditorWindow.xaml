<Window x:Class="Produktionsplanung.App.Views.ArticleEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Artikel bearbeiten" Width="520" Height="680" MinWidth="420" MinHeight="450" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8"/><WrapPanel HorizontalAlignment="Right"><Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0"/><Button Content="Speichern" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Artikelstammdaten" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,16"/>
   <TextBlock Text="Artikelnummer"/><TextBox x:Name="Number" Margin="0,4,0,10"/>
   <TextBlock Text="Name"/><TextBox x:Name="ArticleName" Margin="0,4,0,10"/>
   <TextBlock Text="Einheit"/><ComboBox x:Name="Unit" IsEditable="True" Margin="0,4,0,10"/>
   <TextBlock Text="Standardmenge (optional)"/><TextBox x:Name="Quantity" Margin="0,4,0,10"/>
   <TextBlock Text="Sollrate pro Stunde"/><TextBox x:Name="Rate" Margin="0,4,0,10"/>
   <TextBlock Text="Standard-Arbeitsplan (optional)"/><ComboBox x:Name="Routing" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,10"/>
   <CheckBox x:Name="Active" Content="Artikel aktiv" Margin="0,4,0,10"/>
   <TextBlock Text="Notizen"/><TextBox x:Name="Notes" AcceptsReturn="True" Height="75" TextWrapping="Wrap" Margin="0,4,0,10"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
