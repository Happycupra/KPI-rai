<Window x:Class="Produktionsplanung.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Produktionsplanung.App.Views"
        Title="SolutionCompakt – Produktions- &amp; Personalplanung" Icon="{StaticResource SolutionCompaktIcon}"
        Height="840" Width="1480" MinHeight="720" MinWidth="1120"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D9E6F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#153653" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="14,14,14,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Border x:Name="FullBrand" Background="White" CornerRadius="10" Padding="4">
                        <views:BrandLogo HorizontalAlignment="Center" />
                    </Border>
                    <Border x:Name="CompactBrand" Width="44" Height="44" Background="White" CornerRadius="10"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                        <Image Source="{StaticResource SolutionCompaktIcon}" Width="30" Height="30" />
                    </Border>
                </Grid>

                <Border DockPanel.Dock="Bottom" BorderBrush="#27455F" BorderThickness="0,1,0,0" Padding="4,12,4,0">
                    <StackPanel>
                        <StackPanel x:Name="FooterDetails">
                            <TextBlock x:Name="SessionInfoBlock" Foreground="#D5E0EA" FontSize="12" TextWrapping="Wrap" />
                            <Button Content="Passwort ändern" Height="31" Margin="0,8,0,4" Click="ChangePassword_Click"
                                    Style="{StaticResource NavButtonStyle}" />
                            <TextBlock x:Name="VersionBlock" Foreground="#7F9BB4" FontSize="11" Margin="2,4,0,0" />
                            <TextBlock Text="Windows Desktop · SQLite" Foreground="#7F9BB4" FontSize="11" Margin="2,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="CompactFooter" Text="●" Foreground="#60A5FA" FontSize="17"
                                   HorizontalAlignment="Center" Visibility="Collapsed" ToolTip="Angemeldet" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel">
                        <TextBlock x:Name="PlanningGroupLabel" Text="PLANUNG" Foreground="#718DA5" FontSize="10" FontWeight="Bold" Margin="12,3,0,5" />
                        <Button x:Name="DashboardButton" Tag="▦|Dashboard" Content="▦   Dashboard" Style="{StaticResource NavButtonStyle}" Click="ShowDashboard_Click" />
                        <Button x:Name="PlanningCalendarButton" Tag="▣|Planungskalender" Content="▣   Planungskalender" Style="{StaticResource NavButtonStyle}" Click="ShowPlanningCalendar_Click" />
                        <Button x:Name="DayPlanningButton" Tag="●|Tagesplanung" Content="●   Tagesplanung" Style="{StaticResource NavButtonStyle}" Click="ShowDayPlanning_Click" />
                        <Button x:Name="WeekPlanningButton" Tag="▤|Wochenplanung" Content="▤   Wochenplanung" Style="{StaticResource NavButtonStyle}" Click="ShowWeekPlanning_Click" />
                        <Button x:Name="WorkTimeCalendarButton" Tag="◷|Arbeitszeit / Betrieb" Content="◷   Arbeitszeit / Betrieb" Style="{StaticResource NavButtonStyle}" Click="ShowWorkTimeCalendar_Click" />

                        <TextBlock x:Name="ProductionGroupLabel" Text="PRODUKTION" Foreground="#718DA5" FontSize="10" FontWeight="Bold" Margin="12,15,0,5" />
                        <Button x:Name="ProductionOrdersButton" Tag="▧|Produktionsaufträge" Content="▧   Produktionsaufträge" Style="{StaticResource NavButtonStyle}" Click="ShowProductionOrders_Click" />
                        <Button x:Name="ProductionActualButton" Tag="◉|Ist-Produktion / OEE" Content="◉   Ist-Produktion / OEE" Style="{StaticResource NavButtonStyle}" Click="ShowProductionActual_Click" />
                        <Button x:Name="AnalyticsButton" Tag="⌁|Auswertungen / KPIs" Content="⌁   Auswertungen / KPIs" Style="{StaticResource NavButtonStyle}" Click="ShowAnalytics_Click" />

                        <TextBlock x:Name="MasterDataGroupLabel" Text="STAMMDATEN" Foreground="#718DA5" FontSize="10" FontWeight="Bold" Margin="12,15,0,5" />
                        <Button x:Name="EmployeesButton" Tag="♙|Mitarbeiter" Content="♙   Mitarbeiter" Style="{StaticResource NavButtonStyle}" Click="ShowEmployees_Click" />
                        <Button x:Name="SkillsButton" Tag="◆|Skill-Matrix" Content="◆   Skill-Matrix" Style="{StaticResource NavButtonStyle}" Click="ShowSkills_Click" />
                        <Button x:Name="WorkstationsButton" Tag="▥|Arbeitsplätze" Content="▥   Arbeitsplätze" Style="{StaticResource NavButtonStyle}" Click="ShowWorkstations_Click" />
                        <Button x:Name="ShiftsButton" Tag="↔|Schichten" Content="↔   Schichten" Style="{StaticResource NavButtonStyle}" Click="ShowShifts_Click" />
                        <Button x:Name="AbsencesButton" Tag="○|Abwesenheiten" Content="○   Abwesenheiten" Style="{StaticResource NavButtonStyle}" Click="ShowAbsences_Click" />

                        <TextBlock x:Name="AdminGroupLabel" Text="SYSTEM" Foreground="#718DA5" FontSize="10" FontWeight="Bold" Margin="12,15,0,5" />
                        <Button x:Name="UserAdminButton" Tag="♚|Benutzer / Audit" Content="♚   Benutzer / Audit" Style="{StaticResource NavButtonStyle}" Click="ShowUserAdmin_Click" />
                        <Button x:Name="SettingsButton" Tag="⚙|Einstellungen" Content="⚙   Einstellungen" Style="{StaticResource NavButtonStyle}" Click="ShowSettings_Click" Margin="0,2,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SidebarToggleButton" Grid.Column="0" Content="☰" Width="38" Height="36" Padding="0"
                            FontSize="17" ToolTip="Navigation ein-/ausklappen" Click="ToggleSidebar_Click" Margin="0,0,8,0" />
                    <Button x:Name="BackButton" Grid.Column="1" Content="←  Zurück" Height="36" Padding="12,0"
                            Click="Back_Click" IsEnabled="False" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentPageTitle" Text="Dashboard" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="SolutionCompakt" Foreground="#94A3B8" FontSize="10" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="#EFF6FF" CornerRadius="15" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="Planen · Organisieren · Voranbringen" Foreground="#1D4ED8" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
