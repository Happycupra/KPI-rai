<UserControl x:Class="Produktionsplanung.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Produktionsplanung.App.Views"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <Style x:Key="DashboardMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="DashboardMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Betriebsübersicht" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Heute: Personal, Aufträge, Linien und Handlungsbedarf auf einen Blick." Style="{StaticResource PageSubtitleTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="↻  Aktualisieren" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" Click="RefreshBatches_Click" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="Schnellzugriff" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Direkt zum nächsten Arbeitsschritt" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Planung öffnen" Style="{StaticResource ActionButtonStyle}" Click="OpenPlanning_Click" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Aufträge" Style="{StaticResource ActionButtonStyle}" Click="OpenOrders_Click" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Content="Fertigungssteuerung" Style="{StaticResource ActionButtonStyle}" Click="OpenControl_Click" Margin="0,0,8,0" />
                    <Button Grid.Column="4" Content="Ist-Produktion / OEE" Style="{StaticResource PrimaryActionButtonStyle}" Click="OpenActual_Click" />
                </Grid>
            </Border>

            <!-- Primary operational KPIs. OEE is intentionally not shown here because DashboardViewModel does not expose a dashboard OEE value. -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Personalabdeckung" Style="{StaticResource DashboardMetricLabel}" />
                            <TextBlock Text="{Binding PersonnelCoveragePercent, StringFormat={}{0}%}" Style="{StaticResource DashboardMetricValue}" Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="heute gedeckter Bedarf" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8">
                            <TextBlock Text="✓" Foreground="{StaticResource PrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Laufende Chargen" Style="{StaticResource DashboardMetricLabel}" />
                            <TextBlock Text="{Binding RunningOrders}" Style="{StaticResource DashboardMetricValue}" Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="aktuell in Produktion" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource InfoSoftBrush}" CornerRadius="8">
                            <TextBlock Text="▶" Foreground="{StaticResource InfoBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Handlungsbedarf" Style="{StaticResource DashboardMetricLabel}" />
                            <TextBlock Text="{Binding OpenProblems}" Style="{StaticResource DashboardMetricValue}" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="offene Hinweise &amp; Probleme" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource DangerSoftBrush}" CornerRadius="8">
                            <TextBlock Text="!" Foreground="{StaticResource DangerBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Chargen heute" Style="{StaticResource DashboardMetricLabel}" />
                            <TextBlock Text="{Binding OrdersToday}" Style="{StaticResource DashboardMetricValue}" />
                            <TextBlock Text="geplante Aufträge" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8">
                            <TextBlock Text="▤" Foreground="{StaticResource MutedTextBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Artikel" Click="OpenArticles_Click" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}"/><Button Content="Abgeschlossene Chargen" Click="OpenArchive_Click" Style="{StaticResource ActionButtonStyle}"/></WrapPanel><TextBlock Text="Chargenübersicht" Style="{StaticResource SectionHeaderTextStyle}"/></DockPanel>
                    <views:BatchBrowserView x:Name="Batches"/>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16" Padding="14" CornerRadius="10" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackupStatusSeverity}" Value="Gelb">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BackupStatusSeverity}" Value="Rot">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource CardBrush}" Margin="0,0,12,0">
                        <TextBlock Text="↥" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackupStatusSeverity}" Value="Gelb"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding BackupStatusSeverity}" Value="Rot"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Datensicherung" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding BackupStatusText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Handlungsbedarf directly below the primary KPI row -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Konfliktzentrale" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="Engpässe, Qualifikationen, Abwesenheiten und überfällige Aufträge" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DangerChipStyle}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding OpenProblems, StringFormat=⚠ {0} offen}" Foreground="{StaticResource DangerBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OpenProblems}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AlertCardStyle}" Background="{StaticResource SubtleSurfaceBrush}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border x:Name="SeverityChip" Style="{StaticResource DangerChipStyle}" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock x:Name="SeverityText" Text="KRITISCH" Foreground="{StaticResource DangerBrush}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Öffnen" Style="{StaticResource SecondaryButtonStyle}" Click="OpenIssue_Click" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Gelb">
                                        <Setter TargetName="SeverityChip" Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        <Setter TargetName="SeverityChip" Property="BorderBrush" Value="#FED7AA" />
                                        <Setter TargetName="SeverityText" Property="Text" Value="WARNUNG" />
                                        <Setter TargetName="SeverityText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="#BBE7C9" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding OpenProblems}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✓  Keine offenen Probleme für heute." Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Tagesübersicht" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8" />
            <UniformGrid Columns="6" Margin="0,0,0,16">
                <Border Style="{StaticResource SectionCardStyle}" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Aktiv" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding ActiveEmployees}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SectionCardStyle}" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Verfügbar" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding AvailableEmployees}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SectionCardStyle}" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Eingeplant" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding PlannedEmployees}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SectionCardStyle}" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Abwesend" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding AbsentEmployees}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SectionCardStyle}" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Abgeschlossen" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding CompletedOrdersToday}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SectionCardStyle}" Padding="14"><StackPanel><TextBlock Text="Unterbesetzt" Style="{StaticResource DashboardMetricLabel}"/><TextBlock Text="{Binding UnderstaffedOrders}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/></StackPanel></Border>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Arbeitsplatzstatus heute" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding WorkstationStatuses}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" MaxHeight="340">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.25*" />
                                <DataGridTextColumn Header="Läufe" Binding="{Binding OrderCount}" Width="55" />
                                <DataGridTextColumn Header="Personal" Binding="{Binding CoverageText}" Width="70" />
                                <DataGridTemplateColumn Header="Status" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="LineStatusChip" Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="LineStatusText" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Bereit"><Setter TargetName="LineStatusChip" Property="Background" Value="{StaticResource InfoSoftBrush}"/><Setter TargetName="LineStatusText" Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Abgeschlossen"><Setter TargetName="LineStatusChip" Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter TargetName="LineStatusText" Property="Text" Value="✓ Abgeschlossen"/><Setter TargetName="LineStatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Personal fehlt"><Setter TargetName="LineStatusChip" Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter TargetName="LineStatusText" Property="Text" Value="⚠ Personal fehlt"/><Setter TargetName="LineStatusText" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Problem"><Setter TargetName="LineStatusChip" Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter TargetName="LineStatusText" Property="Text" Value="! Problem"/><Setter TargetName="LineStatusText" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Kein Lauf"><Setter TargetName="LineStatusText" Property="Text" Value="— Kein Lauf"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Aufträge heute" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="Produkt, Arbeitsplatz, Schicht und aktuelle Personalabdeckung" Style="{StaticResource PageSubtitleTextStyle}" Margin="0,2,0,10" />
                        <DataGrid ItemsSource="{Binding TodayOrders}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="220" MaxHeight="340">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Auftrag" Binding="{Binding OrderNumber}" Width="90" />
                                <DataGridTextColumn Header="Produkt" Binding="{Binding Product}" Width="1.2*" />
                                <DataGridTextColumn Header="Arbeitsplatz" Binding="{Binding WorkstationName}" Width="1.05*" />
                                <DataGridTextColumn Header="Schicht" Binding="{Binding ShiftName}" Width="95" />
                                <DataGridTextColumn Header="Personal" Binding="{Binding CoverageText}" Width="70" />
                                <DataGridTemplateColumn Header="Abdeckung" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CoverageChip" Style="{StaticResource SuccessChipStyle}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="CoverageText" Text="{Binding CoverageStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding CoverageStatus}" Value="Unterbesetzt"><Setter TargetName="CoverageChip" Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter TargetName="CoverageChip" Property="BorderBrush" Value="#FECACA"/><Setter TargetName="CoverageText" Property="Text" Value="⚠ Unterbesetzt"/><Setter TargetName="CoverageText" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding CoverageStatus}" Value="Abgeschlossen"><Setter TargetName="CoverageText" Property="Text" Value="✓ Abgeschlossen"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
