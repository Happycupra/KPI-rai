<Window x:Class="Produktionsplanung.App.RecoveryCodeManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolutionCompakt – Recovery-Code erneuern"
        Icon="{StaticResource SolutionCompaktIcon}"
        Width="520" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SubtleSurfaceBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Recovery-Code erneuern" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Der bisherige Recovery-Code wird sofort ungültig. Zur Sicherheit musst du dein aktuelles Administrator-Passwort erneut bestätigen."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,18" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel x:Name="VerificationPanel">
                <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                    <TextBlock Text="Bewahre den neuen Code ausserhalb der App auf, z. B. im Passwortmanager oder ausgedruckt in einem sicheren Ordner. Er kann später nicht erneut angezeigt werden."
                               Foreground="#9A3412" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Aktuelles Administrator-Passwort" FontWeight="SemiBold" />
                <PasswordBox x:Name="CurrentPasswordBox" Height="38" Margin="0,5,0,12" />
                <TextBlock x:Name="StatusBlock" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="28" />
            </StackPanel>

            <StackPanel x:Name="GeneratedPanel" Visibility="Collapsed">
                <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Neuer Recovery-Code" FontWeight="SemiBold" Foreground="#166534" />
                        <TextBlock Text="Der alte Code ist jetzt ungültig. Dieser neue Code wird nur in diesem Fenster im Klartext angezeigt."
                                   Foreground="#166534" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <TextBox x:Name="RecoveryCodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                                 TextAlignment="Center" Height="42" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Content="In Zwischenablage kopieren" HorizontalAlignment="Center" Click="Copy_Click" Style="{StaticResource ActionButtonStyle}" />
                <TextBlock x:Name="CopyStatusBlock" Foreground="#15803D" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Abbrechen" Width="104" IsCancel="True" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" />
            <Button x:Name="GenerateButton" Content="Neuen Code erzeugen" Width="160" IsDefault="True"
                    Click="Generate_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
            <Button x:Name="DoneButton" Content="Fertig" Width="104" Visibility="Collapsed"
                    Click="Done_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
