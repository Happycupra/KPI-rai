<UserControl x:Class="Produktionsplanung.App.Views.UserAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="310" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Benutzer &amp; Audit" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Lokale Benutzer, Rollen und die letzten 500 Audit-Einträge verwalten."
                           Style="{StaticResource PageSubtitleTextStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Aktualisieren"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ActionButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCardStyle}" Padding="12">
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Benutzer" Binding="{Binding Username}" Width="*" />
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.2*" />
                        <DataGridTextColumn Header="Rolle" Binding="{Binding Role}" Width="105" />
                        <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="60" />
                        <DataGridTextColumn Header="Letzter Login" Binding="{Binding LastLoginText}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding EditorTitle}"
                               Style="{StaticResource DialogTitleTextStyle}"
                               Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,4">
                            <TextBlock Text="Benutzername" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="Anzeigename" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rolle" Style="{StaticResource FieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding RoleOptions}"
                                              SelectedItem="{Binding SelectedRole}"
                                              Margin="0,0,8,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Content="Aktiv"
                                          IsChecked="{Binding IsActive}"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,9" />
                            </Grid>

                            <TextBlock Text="Neues Passwort / Passwort zurücksetzen" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="NewPasswordBox"
                                         PasswordChanged="NewPasswordBox_PasswordChanged"
                                         Margin="0,0,0,8" />

                            <TextBlock Text="Passwort bestätigen" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                         Margin="0,0,0,4" />
                            <TextBlock Text="Mindestens 10 Zeichen, 1 Grossbuchstabe, 1 Kleinbuchstabe und 1 Zahl. Bei bestehenden Benutzern beide Felder leer lassen, wenn das Passwort unverändert bleiben soll."
                                       Style="{StaticResource SecondaryTextStyle}"
                                       FontSize="11"
                                       Margin="0,0,0,10" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="+ Neuer Benutzer"
                                    Command="{Binding NewUserCommand}"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ActionButtonStyle}" />
                            <Button Content="QR-Code erstellen"
                                    Click="CreateQrCode_Click"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ActionButtonStyle}" />
                            <Button Content="Speichern"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Command="{Binding SaveUserCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="12">
            <StackPanel>
                <TextBlock Text="Audit-Log" Style="{StaticResource SectionHeaderTextStyle}" Margin="4,2,4,10" />
                <DataGrid ItemsSource="{Binding AuditRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zeit" Binding="{Binding TimestampText}" Width="145" />
                        <DataGridTextColumn Header="Benutzer" Binding="{Binding Username}" Width="110" />
                        <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="100" />
                        <DataGridTextColumn Header="Bereich" Binding="{Binding EntityType}" Width="130" />
                        <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="70" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>