<Window x:Class="Produktionsplanung.App.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolutionCompakt – Passwort ändern" Icon="{StaticResource SolutionCompaktIcon}" Width="430" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SubtleSurfaceBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="Passwort ändern" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
        <TextBlock Text="Mindestens 10 Zeichen, Gross-/Kleinbuchstaben und eine Zahl." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,18" />
        <TextBlock Text="Aktuelles Passwort" FontWeight="SemiBold" />
        <PasswordBox x:Name="CurrentPasswordBox" Height="34" Margin="0,4,0,12" />
        <TextBlock Text="Neues Passwort" FontWeight="SemiBold" />
        <PasswordBox x:Name="NewPasswordBox" Height="34" Margin="0,4,0,12" />
        <TextBlock Text="Neues Passwort bestätigen" FontWeight="SemiBold" />
        <PasswordBox x:Name="ConfirmPasswordBox" Height="34" Margin="0,4,0,10" />
        <TextBlock x:Name="StatusBlock" Foreground="#DC2626" TextWrapping="Wrap" MinHeight="24" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="Abbrechen" Width="104" IsCancel="True" Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}" />
            <Button Content="Ändern" Width="104" IsDefault="True" Click="Change_Click" Style="{StaticResource PrimaryActionButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
