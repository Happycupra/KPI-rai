<UserControl x:Class="Produktionsplanung.App.Views.AbsencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource PageHeaderSpacing}">
            <TextBlock Text="Abwesenheiten" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Ferien, Krankheit und weitere Abwesenheiten erfassen."
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid>
                <DataGrid x:Name="AbsencesGrid"
                          ItemsSource="{Binding Absences}"
                          SelectedItem="{Binding SelectedAbsence}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="AbsenceRow_PreviewMouseRightButtonDown" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Mitarbeiterkarte" Click="EmployeeCardContext_Click" />
                            <MenuItem Header="Skills / Stammdaten" Click="EmployeeMasterContext_Click" />
                            <MenuItem Header="Aktuell geplant" Click="EmployeePlanContext_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding EmployeeName}" Width="2*" />
                        <DataGridTextColumn Header="Art" Binding="{Binding Type}" Width="*" />
                        <DataGridTextColumn Header="Von" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="110" />
                        <DataGridTextColumn Header="Bis" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="110" />
                        <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="380">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource EmptyStateStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=AbsencesGrid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Keine Abwesenheiten erfasst."
                                   Style="{StaticResource CardTitleTextStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Neue Abwesenheiten kannst du rechts erfassen."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,4,0,0"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource EditorCardStyle}">
                <StackPanel>
                    <TextBlock Text="Abwesenheit bearbeiten"
                               Style="{StaticResource DialogTitleTextStyle}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Mitarbeiter" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding SelectedEmployee}"
                              Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding LastName}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding FirstName}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Art" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding AbsenceTypes}"
                              SelectedItem="{Binding AbsenceType}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Startdatum" Style="{StaticResource FieldLabelTextStyle}" />
                    <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,0,12" />

                    <TextBlock Text="Enddatum" Style="{StaticResource FieldLabelTextStyle}" />
                    <DatePicker SelectedDate="{Binding EndDate}" Margin="0,0,0,12" />

                    <TextBlock Text="Kommentar" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,0,0,16"
                             VerticalScrollBarVisibility="Auto" />

                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Neu"
                                Command="{Binding NewAbsenceCommand}"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="Speichern"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                        <Button Content="In Papierkorb"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerActionButtonStyle}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>