<Window x:Class="Produktionsplanung.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Produktionsplanung.App.Views"
        Title="SolutionCompakt – Produktions- &amp; Personalplanung" Icon="{StaticResource SolutionCompaktIcon}"
        Height="840" Width="1480" MinHeight="720" MinWidth="1120"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D9E6F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NavIcon" Grid.Column="0" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <TextBlock x:Name="NavLabel" Grid.Column="1" Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HorizontalContentAlignment" Value="Center">
                                <Setter TargetName="NavLabel" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NavIcon" Property="Grid.ColumnSpan" Value="2" />
                                <Setter TargetName="NavIcon" Property="HorizontalAlignment" Value="Center" />
                                <Setter TargetName="NavIcon" Property="FontSize" Value="18" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#153653" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGroupHeaderStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#86A0B6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GroupChrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GroupChrome" Property="Background" Value="#102F49" />
                                <Setter Property="Foreground" Value="#D9E6F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="14,14,14,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Border x:Name="FullBrand" Background="White" CornerRadius="12" Padding="10,6">
                        <views:BrandLogo HorizontalAlignment="Center" />
                    </Border>
                    <Border x:Name="CompactBrand" Width="46" Height="46" Background="White" CornerRadius="12"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                        <Image Source="{StaticResource SolutionCompaktIcon}" Width="32" Height="32" />
                    </Border>
                </Grid>

                <Border DockPanel.Dock="Bottom" BorderBrush="#27455F" BorderThickness="0,1,0,0" Padding="4,12,4,0">
                    <StackPanel>
                        <StackPanel x:Name="FooterDetails">
                            <TextBlock x:Name="SessionInfoBlock" Foreground="#D5E0EA" FontSize="12" TextWrapping="Wrap" />
                            <Button Content="Passwort ändern" Height="31" Margin="0,8,0,4" Click="ChangePassword_Click" />
                            <TextBlock x:Name="VersionBlock" Foreground="#7F9BB4" FontSize="11" Margin="2,4,0,0" />
                            <TextBlock Text="Windows Desktop · SQLite" Foreground="#7F9BB4" FontSize="11" Margin="2,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="CompactFooter" Text="●" Foreground="#60A5FA" FontSize="17"
                                   HorizontalAlignment="Center" Visibility="Collapsed" ToolTip="Angemeldet" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel">
                        <Button x:Name="PlanningGroupHeader" Content="▾  PLANUNG" Style="{StaticResource NavGroupHeaderStyle}" Click="TogglePlanningGroup_Click" Margin="0,3,0,3" />
                        <Button x:Name="DashboardButton" Tag="&#xE80F;" Content="Dashboard" ToolTip="Dashboard" Style="{StaticResource NavButtonStyle}" Click="ShowDashboard_Click" />
                        <Button x:Name="PlanningCalendarButton" Tag="&#xE787;" Content="Planungskalender" ToolTip="Planungskalender" Style="{StaticResource NavButtonStyle}" Click="ShowPlanningCalendar_Click" />
                        <Button x:Name="DayPlanningButton" Tag="&#xE8D4;" Content="Tagesplanung" ToolTip="Tagesplanung" Style="{StaticResource NavButtonStyle}" Click="ShowDayPlanning_Click" />
                        <Button x:Name="WeekPlanningButton" Tag="&#xE823;" Content="Wochenplanung" ToolTip="Wochenplanung" Style="{StaticResource NavButtonStyle}" Click="ShowWeekPlanning_Click" />
                        <Button x:Name="WorkTimeCalendarButton" Tag="&#xE916;" Content="Arbeitszeit / Betrieb" ToolTip="Arbeitszeit / Betrieb" Style="{StaticResource NavButtonStyle}" Click="ShowWorkTimeCalendar_Click" />

                        <Button x:Name="ProductionGroupHeader" Content="▾  PRODUKTION" Style="{StaticResource NavGroupHeaderStyle}" Click="ToggleProductionGroup_Click" Margin="0,12,0,3" />
                        <Button x:Name="ProductionOrdersButton" Tag="&#xE8A5;" Content="Produktionsaufträge" ToolTip="Produktionsaufträge" Style="{StaticResource NavButtonStyle}" Click="ShowProductionOrders_Click" />
                        <Button x:Name="ProductionActualButton" Tag="&#xE9D2;" Content="Ist-Produktion / OEE" ToolTip="Ist-Produktion / OEE" Style="{StaticResource NavButtonStyle}" Click="ShowProductionActual_Click" />
                        <Button x:Name="AnalyticsButton" Tag="&#xE9D9;" Content="Auswertungen / KPIs" ToolTip="Auswertungen / KPIs" Style="{StaticResource NavButtonStyle}" Click="ShowAnalytics_Click" />

                        <Button x:Name="MasterDataGroupHeader" Content="▾  STAMMDATEN" Style="{StaticResource NavGroupHeaderStyle}" Click="ToggleMasterDataGroup_Click" Margin="0,12,0,3" />
                        <Button x:Name="EmployeesButton" Tag="&#xE77B;" Content="Mitarbeiter" ToolTip="Mitarbeiter" Style="{StaticResource NavButtonStyle}" Click="ShowEmployees_Click" />
                        <Button x:Name="SkillsButton" Tag="&#xE735;" Content="Skill-Matrix" ToolTip="Skill-Matrix" Style="{StaticResource NavButtonStyle}" Click="ShowSkills_Click" />
                        <Button x:Name="WorkstationsButton" Tag="&#xE90F;" Content="Arbeitsplätze" ToolTip="Arbeitsplätze" Style="{StaticResource NavButtonStyle}" Click="ShowWorkstations_Click" />
                        <Button x:Name="ShiftsButton" Tag="&#xE8AB;" Content="Schichten" ToolTip="Schichten" Style="{StaticResource NavButtonStyle}" Click="ShowShifts_Click" />
                        <Button x:Name="AbsencesButton" Tag="&#xE711;" Content="Abwesenheiten" ToolTip="Abwesenheiten" Style="{StaticResource NavButtonStyle}" Click="ShowAbsences_Click" />

                        <Button x:Name="SystemGroupHeader" Content="▾  SYSTEM" Style="{StaticResource NavGroupHeaderStyle}" Click="ToggleSystemGroup_Click" Margin="0,12,0,3" />
                        <Button x:Name="UserAdminButton" Tag="&#xE716;" Content="Benutzer / Audit" ToolTip="Benutzer / Audit" Style="{StaticResource NavButtonStyle}" Click="ShowUserAdmin_Click" />
                        <Button x:Name="SettingsButton" Tag="&#xE713;" Content="Einstellungen" ToolTip="Einstellungen" Style="{StaticResource NavButtonStyle}" Click="ShowSettings_Click" Margin="0,2,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SidebarToggleButton" Grid.Column="0" Content="☰" Width="38" Height="36" Padding="0"
                            FontSize="17" ToolTip="Navigation ein-/ausklappen" Click="ToggleSidebar_Click" Margin="0,0,8,0" />
                    <Button x:Name="BackButton" Grid.Column="1" Content="←  Zurück" Height="36" Padding="12,0"
                            Click="Back_Click" IsEnabled="False" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentPageTitle" Text="Dashboard" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="SolutionCompakt" Foreground="#94A3B8" FontSize="10" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="#EFF6FF" CornerRadius="15" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="Planen · Organisieren · Voranbringen" Foreground="#1D4ED8" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
