<UserControl x:Class="Produktionsplanung.App.Views.ProductionActualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ist-Produktion / OEE" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Ist-Mengen, Laufzeiten, Ausschuss und Stillstände erfassen und OEE direkt berechnen."
                               FontSize="15" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Neue Erfassung" Height="34" Padding="14,0" Command="{Binding NewActualCommand}" Margin="0,0,8,0" />
                    <Button Content="Aktualisieren" Height="34" Padding="14,0" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Verfügbarkeit" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding AvailabilityText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Laufzeit / geplante Produktionszeit" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Leistung" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding PerformanceText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Ist-Menge gegen Sollrate" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Qualität" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding QualityText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Gutmenge / Gesamtmenge" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="OEE" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{Binding OeeText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Verfügbarkeit × Leistung × Qualität" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Erfasste Ist-Produktion" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding Actuals}" SelectedItem="{Binding SelectedActual, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" MinHeight="420" MaxHeight="560">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90" />
                                <DataGridTextColumn Header="Auftrag" Binding="{Binding OrderNumber}" Width="90" />
                                <DataGridTextColumn Header="Produkt" Binding="{Binding Product}" Width="1.2*" />
                                <DataGridTextColumn Header="Linie" Binding="{Binding WorkstationName}" Width="1*" />
                                <DataGridTextColumn Header="Schicht" Binding="{Binding ShiftName}" Width="1*" />
                                <DataGridTextColumn Header="Menge" Binding="{Binding QuantityText}" Width="90" />
                                <DataGridTextColumn Header="Ausschuss" Binding="{Binding ScrapText}" Width="85" />
                                <DataGridTextColumn Header="Stillstand" Binding="{Binding DowntimeText}" Width="85" />
                                <DataGridTextColumn Header="OEE" Binding="{Binding OeeText}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ist-Erfassung" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Die Sollrate wird historisch mit der Erfassung gespeichert." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />

                        <TextBlock Text="Produktionsauftrag" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" Height="34" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Datum" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <DatePicker SelectedDate="{Binding ActualDate, Mode=TwoWay}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sollrate / Stunde" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding IdealRatePerHour, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Geplante Produktionszeit (min)" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding PlannedProductionMinutes, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Laufzeit (min)" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding RunMinutes, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Gesamtmenge" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding TotalQuantity, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gutmenge" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding GoodQuantity, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ausschuss" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ScrapQuantity, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding TheoreticalQuantityText, StringFormat=Theoretische Menge bei Sollrate: {0}}" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="Gesamtmenge muss Gutmenge + Ausschuss entsprechen." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Kommentar" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,8" />
                        <Button Content="Ist-Erfassung speichern" Height="38" Command="{Binding SaveCommand}" Margin="0,0,0,8" />
                        <Button Content="Ausgewählte Erfassung löschen" Height="36" Command="{Binding DeleteActualCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Stillstandsgründe" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Stillstände werden der ausgewählten, bereits gespeicherten Ist-Erfassung zugeordnet."
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,10" />
                        <DataGrid ItemsSource="{Binding Downtimes}" SelectedItem="{Binding SelectedDowntime, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="190" MaxHeight="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Grund" Binding="{Binding Reason}" Width="1.1*" />
                                <DataGridTextColumn Header="Dauer" Binding="{Binding MinutesText}" Width="90" />
                                <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Ausgewählten Stillstand löschen" Command="{Binding DeleteDowntimeCommand}"
                                Width="210" Height="34" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Stillstand hinzufügen" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="Grund" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding DowntimeReasons}" SelectedItem="{Binding DowntimeReason, Mode=TwoWay}" Height="34" Margin="0,0,0,12" />
                        <TextBlock Text="Dauer (min)" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding DowntimeMinutes, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Kommentar" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBox Text="{Binding DowntimeComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Button Content="Stillstand erfassen" Height="36" Command="{Binding AddDowntimeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
